<UserControl
    x:Class="Severino.App.Views.RoutesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:views="clr-namespace:Severino.App.Views"
    xmlns:vm="clr-namespace:Severino.App.ViewModels"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance Type=vm:RoutesViewModel}">
    <UserControl.Resources>
        <views:BindingProxy x:Key="Root" Data="{Binding}" />

        <!-- Dot and label share the colour; the label carries the meaning on its own. -->
        <Style x:Key="HealthDot" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Text" Value="●" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Health}" Value="Up">
                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Health}" Value="Down">
                    <Setter Property="Text" Value="◐" />
                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Health}" Value="Disabled">
                    <Setter Property="Text" Value="○" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="HealthLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Health}" Value="Up">
                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Health}" Value="Down">
                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="0,20,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16" Visibility="{Binding HasRoutes, Converter={StaticResource TrueToVisible}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <ui:TextBlock FontTypography="Subtitle" Text="Rotas" />
                <ui:TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontTypography="Caption" Text="{Binding Summary}" />
            </StackPanel>
            <ui:TextBox
                Grid.Column="1"
                Width="220"
                Margin="0,0,8,0"
                VerticalAlignment="Center"
                PlaceholderText="Buscar domínio"
                Icon="{ui:SymbolIcon Search24}"
                AutomationProperties.Name="Buscar rotas"
                Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" />
            <ui:Button
                Grid.Column="2"
                VerticalAlignment="Center"
                Appearance="Primary"
                Icon="{ui:SymbolIcon Add24}"
                Content="Nova rota"
                Command="{Binding NewRouteCommand}" />
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="{Binding HasRoutes, Converter={StaticResource TrueToVisible}}">
            <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:RouteItemViewModel}">
                        <ui:Card Margin="0,0,0,6" Padding="16,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Style="{StaticResource HealthDot}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis">
                                        <Hyperlink
                                            Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                            TextDecorations="{x:Null}"
                                            Command="{Binding Data.OpenCommand, Source={StaticResource Root}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="Abrir no navegador">
                                            <Run Text="{Binding Domain, Mode=OneWay}" />
                                        </Hyperlink>
                                    </TextBlock>
                                    <ui:TextBlock
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        FontTypography="Caption"
                                        TextTrimming="CharacterEllipsis"
                                        Text="{Binding TargetDisplay, StringFormat='→ {0}'}" />
                                </StackPanel>
                                <TextBlock
                                    Grid.Column="2"
                                    Margin="16,0"
                                    Style="{StaticResource HealthLabel}"
                                    Text="{Binding HealthText}" />
                                <ui:ToggleSwitch
                                    Grid.Column="3"
                                    VerticalAlignment="Center"
                                    IsChecked="{Binding Enabled}"
                                    AutomationProperties.Name="{Binding Domain, StringFormat='Ligar {0}'}" />
                                <ui:Button
                                    Grid.Column="4"
                                    Margin="8,0,0,0"
                                    Appearance="Transparent"
                                    Icon="{ui:SymbolIcon MoreHorizontal24}"
                                    AutomationProperties.Name="{Binding Domain, StringFormat='Mais opções de {0}'}"
                                    Click="OnMoreClick">
                                    <ui:Button.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Abrir no navegador" Command="{Binding Data.OpenCommand, Source={StaticResource Root}}" CommandParameter="{Binding}" />
                                            <MenuItem Header="Copiar URL" Command="{Binding Data.CopyUrlCommand, Source={StaticResource Root}}" CommandParameter="{Binding}" />
                                            <Separator />
                                            <MenuItem Header="Editar" Command="{Binding Data.EditCommand, Source={StaticResource Root}}" CommandParameter="{Binding}" />
                                            <MenuItem Header="Duplicar" Command="{Binding Data.DuplicateCommand, Source={StaticResource Root}}" CommandParameter="{Binding}" />
                                            <Separator />
                                            <MenuItem Header="Remover" Command="{Binding Data.RemoveCommand, Source={StaticResource Root}}" CommandParameter="{Binding}" />
                                        </ContextMenu>
                                    </ui:Button.ContextMenu>
                                </ui:Button>
                            </Grid>
                        </ui:Card>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <StackPanel
            Grid.Row="1"
            MaxWidth="420"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Visibility="{Binding IsEmpty, Converter={StaticResource TrueToVisible}}">
            <Image
                Width="112"
                Height="112"
                Source="/Assets/severino-512.png"
                RenderOptions.BitmapScalingMode="HighQuality"
                AutomationProperties.Name="Severino, o porteiro" />
            <ui:TextBlock
                Margin="0,16,0,4"
                HorizontalAlignment="Center"
                FontTypography="Subtitle"
                Text="O Severino está na portaria" />
            <ui:TextBlock
                HorizontalAlignment="Center"
                TextAlignment="Center"
                TextWrapping="Wrap"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="Diga a ele qual domínio leva a qual servidor, como callfred.sev para localhost:3000, e ele cuida do resto." />
            <ui:Button
                Margin="0,20,0,0"
                HorizontalAlignment="Center"
                Appearance="Primary"
                Icon="{ui:SymbolIcon Add24}"
                Content="Criar primeira rota"
                Command="{Binding NewRouteCommand}" />
        </StackPanel>

        <StackPanel Grid.Row="2">
            <ui:Card Margin="0,8,0,0" Padding="16,8" Visibility="{Binding UndoMessage, Converter={StaticResource NullToCollapsed}}">
                <DockPanel>
                    <ui:Button DockPanel.Dock="Right" Content="Desfazer" Command="{Binding UndoCommand}" />
                    <ui:TextBlock VerticalAlignment="Center" Text="{Binding UndoMessage}" />
                </DockPanel>
            </ui:Card>
            <ui:Card Margin="0,8,0,0" Padding="16,10" Visibility="{Binding Toast, Converter={StaticResource NullToCollapsed}}">
                <ui:TextBlock Text="{Binding Toast}" />
            </ui:Card>
        </StackPanel>
    </Grid>
</UserControl>
