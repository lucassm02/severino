<UserControl
    x:Class="Severino.App.Views.RoutesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:views="clr-namespace:Severino.App.Views"
    xmlns:vm="clr-namespace:Severino.App.ViewModels"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance Type=vm:RoutesViewModel}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Severino;component/Views/ListStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <views:BindingProxy x:Key="Root" Data="{Binding}" />
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="0,20,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16" Visibility="{Binding HasRoutes, Converter={StaticResource TrueToVisible}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <ui:TextBlock FontTypography="Subtitle" Text="Rotas" />
                    <ui:TextBlock
                        Margin="12,0,0,3"
                        VerticalAlignment="Bottom"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        FontTypography="Caption"
                        Text="{Binding Summary}" />
                </StackPanel>
                <ui:TextBlock
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    FontTypography="Caption"
                    TextWrapping="Wrap"
                    Text="Para abrir no navegador: o nome passa pelo proxy, com HTTPS, caminhos e curingas." />
            </StackPanel>
            <ui:TextBox
                Grid.Column="1"
                Width="220"
                Margin="16,0,8,0"
                VerticalAlignment="Center"
                PlaceholderText="Buscar domínio ou destino"
                Icon="{ui:SymbolIcon Search24}"
                AutomationProperties.Name="Buscar rotas"
                Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" />
            <ui:Button
                Grid.Column="2"
                VerticalAlignment="Center"
                Appearance="Primary"
                Icon="{ui:SymbolIcon Add24}"
                Content="Nova rota"
                Command="{Binding NewRouteCommand}" />
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="{Binding HasRoutes, Converter={StaticResource TrueToVisible}}">
            <StackPanel>
                <ui:Card Margin="0,0,0,8" Padding="16,10" Visibility="{Binding WildcardPendingText, Converter={StaticResource NullToCollapsed}}">
                    <DockPanel>
                        <ui:Button DockPanel.Dock="Right" Margin="12,0,0,0" Icon="{ui:SymbolIcon ShieldCheckmark24}" Content="Aprovar" Command="{Binding ApproveWildcardsCommand}" />
                        <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding WildcardPendingText}" />
                    </DockPanel>
                </ui:Card>
                <ItemsControl ItemsSource="{Binding RouteGroups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:RouteGroupViewModel}">
                            <StackPanel Margin="0,0,0,8">
                                <!-- A named group: one switch for all its routes, lined up with theirs. -->
                                <DockPanel Margin="0,6,17,6" Visibility="{Binding HasName, Converter={StaticResource TrueToVisible}}">
                                    <ui:Button
                                        DockPanel.Dock="Right"
                                        Margin="8,0,0,0"
                                        Appearance="Transparent"
                                        Icon="{ui:SymbolIcon MoreHorizontal24}"
                                        AutomationProperties.Name="{Binding Name, StringFormat='Mais opções do grupo {0}'}"
                                        Click="OnMoreClick">
                                        <ui:Button.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Nova rota neste grupo" Command="{Binding Data.NewRouteInGroupCommand, Source={StaticResource Root}}" CommandParameter="{Binding}" />
                                                <MenuItem Header="Renomear grupo…" Command="{Binding Data.RenameGroupCommand, Source={StaticResource Root}}" CommandParameter="{Binding}" />
                                                <Separator />
                                                <MenuItem
                                                    Header="Desfazer o grupo"
                                                    ToolTip="As rotas ficam, sem grupo"
                                                    Command="{Binding Data.UngroupCommand, Source={StaticResource Root}}"
                                                    CommandParameter="{Binding}" />
                                            </ContextMenu>
                                        </ui:Button.ContextMenu>
                                    </ui:Button>
                                    <ui:ToggleSwitch
                                        DockPanel.Dock="Right"
                                        VerticalAlignment="Center"
                                        IsChecked="{Binding Enabled}"
                                        ToolTip="Liga ou desliga todas as rotas do grupo"
                                        AutomationProperties.Name="{Binding Name, StringFormat='Ligar o grupo {0}'}" />
                                    <StackPanel VerticalAlignment="Center">
                                        <ui:TextBlock FontTypography="BodyStrong" Text="{Binding Name}" />
                                        <ui:TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontTypography="Caption" Text="{Binding Summary}" />
                                    </StackPanel>
                                </DockPanel>
                                <ItemsControl ItemsSource="{Binding Items}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:RouteItemViewModel}">
                                            <ui:Card Margin="0,0,0,6" Padding="16,10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="24" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Style="{StaticResource HealthDot}" />
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis">
                                                            <Hyperlink
                                                                Style="{StaticResource RowLink}"
                                                                Command="{Binding Data.OpenCommand, Source={StaticResource Root}}"
                                                                CommandParameter="{Binding}"
                                                                ToolTip="Abrir no navegador">
                                                                <Run Text="{Binding DisplayName, Mode=OneWay}" />
                                                            </Hyperlink>
                                                            <InlineUIContainer BaselineAlignment="Center">
                                                                <Border
                                                                    Style="{StaticResource Badge}"
                                                                    ToolTip="{Binding HttpsBadgeTooltip}"
                                                                    AutomationProperties.Name="{Binding HttpsBadgeTooltip}"
                                                                    Visibility="{Binding HasHttpsBadge, Converter={StaticResource TrueToVisible}}">
                                                                    <TextBlock Text="{Binding HttpsBadgeText}">
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="TextBlock" BasedOn="{StaticResource BadgeText}">
                                                                                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding HttpsState}" Value="Uncovered">
                                                                                        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>
                                                                </Border>
                                                            </InlineUIContainer>
                                                        </TextBlock>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Style="{StaticResource RowCaption}" Text="{Binding TargetDisplay, StringFormat='→ {0}'}" />
                                                            <!-- The target goes by a DNS name: its IP, and the way to change it. -->
                                                            <TextBlock
                                                                Margin="12,0,0,0"
                                                                Style="{StaticResource RowCaption}"
                                                                ToolTip="Ver na aba DNS: mudar o IP lá muda o destino"
                                                                Visibility="{Binding DestinationText, Converter={StaticResource NullToCollapsed}}">
                                                                <Hyperlink Style="{StaticResource RowLink}" Command="{Binding Data.ShowDnsCommand, Source={StaticResource Root}}" CommandParameter="{Binding Destination.Name}">
                                                                    <Run Text="{Binding DestinationText, Mode=OneWay}" />
                                                                </Hyperlink>
                                                            </TextBlock>
                                                        </StackPanel>
                                                    </StackPanel>
                                                    <TextBlock
                                                        Grid.Column="2"
                                                        Margin="16,0"
                                                        Style="{StaticResource HealthLabel}"
                                                        Text="{Binding HealthText}" />
                                                    <ui:ToggleSwitch
                                                        Grid.Column="3"
                                                        VerticalAlignment="Center"
                                                        IsChecked="{Binding Enabled}"
                                                        AutomationProperties.Name="{Binding Domain, StringFormat='Ligar {0}'}" />
                                                    <ui:Button
                                                        Grid.Column="4"
                                                        Margin="8,0,0,0"
                                                        Appearance="Transparent"
                                                        Icon="{ui:SymbolIcon MoreHorizontal24}"
                                                        AutomationProperties.Name="{Binding Domain, StringFormat='Mais opções de {0}'}"
                                                        Click="OnMoreClick">
                                                        <ui:Button.ContextMenu>
                                                            <ContextMenu>
                                                                <MenuItem Header="Abrir no navegador" Command="{Binding Data.OpenCommand, Source={StaticResource Root}}" CommandParameter="{Binding}" />
                                                                <MenuItem Header="Copiar URL" Command="{Binding Data.CopyUrlCommand, Source={StaticResource Root}}" CommandParameter="{Binding}" />
                                                                <Separator />
                                                                <MenuItem Header="Editar" Command="{Binding Data.EditCommand, Source={StaticResource Root}}" CommandParameter="{Binding}" />
                                                                <MenuItem Header="Duplicar" Command="{Binding Data.DuplicateCommand, Source={StaticResource Root}}" CommandParameter="{Binding}" />
                                                                <MenuItem
                                                                    Header="Transformar em entrada DNS…"
                                                                    ToolTip="Para rotas cujo destino é um IP: o nome passa a ir direto a ele, sem o proxy"
                                                                    Command="{Binding Data.MakeDnsCommand, Source={StaticResource Root}}"
                                                                    CommandParameter="{Binding}" />
                                                                <Separator />
                                                                <MenuItem Header="Remover" Command="{Binding Data.RemoveCommand, Source={StaticResource Root}}" CommandParameter="{Binding}" />
                                                            </ContextMenu>
                                                        </ui:Button.ContextMenu>
                                                    </ui:Button>
                                                </Grid>
                                            </ui:Card>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="{Binding IsEmpty, Converter={StaticResource TrueToVisible}}">
            <StackPanel MaxWidth="520" Margin="0,8" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Image
                    Width="96"
                    Height="96"
                    Source="/Assets/severino-512.png"
                    RenderOptions.BitmapScalingMode="HighQuality"
                    AutomationProperties.Name="Severino, o porteiro" />
                <ui:TextBlock
                    Margin="0,12,0,4"
                    HorizontalAlignment="Center"
                    FontTypography="Subtitle"
                    Text="O Severino está na portaria" />
                <ui:TextBlock
                    Margin="0,0,0,16"
                    HorizontalAlignment="Center"
                    TextAlignment="Center"
                    TextWrapping="Wrap"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="Diga a ele qual domínio leva a qual servidor, como callfred.sev para localhost:3000, e ele cuida do resto." />
                <views:NameKindsPanel />
                <ui:Button
                    Margin="0,16,0,0"
                    HorizontalAlignment="Center"
                    Appearance="Primary"
                    Icon="{ui:SymbolIcon Add24}"
                    Content="Criar primeira rota"
                    Command="{Binding NewRouteCommand}" />
            </StackPanel>
        </ScrollViewer>

        <views:PageFooter Grid.Row="2" />
    </Grid>
</UserControl>
