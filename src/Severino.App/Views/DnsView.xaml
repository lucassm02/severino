<UserControl
    x:Class="Severino.App.Views.DnsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:res="clr-namespace:Severino.App.Resources"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:views="clr-namespace:Severino.App.Views"
    xmlns:vm="clr-namespace:Severino.App.ViewModels"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance Type=vm:DnsViewModel}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Severino;component/Views/ListStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <views:BindingProxy x:Key="Root" Data="{Binding}" />

            <Style x:Key="Caption" TargetType="TextBlock" BasedOn="{StaticResource RowCaption}" />
            <Style x:Key="StateText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsPending}" Value="True">
                        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- "Destino de 1 rota e 3 serviços", each part a link to the tab that has them. -->
            <DataTemplate x:Key="UsedBy" DataType="{x:Type vm:DnsRowViewModel}">
                <TextBlock Style="{StaticResource Caption}" Visibility="{Binding IsUsed, Converter={StaticResource TrueToVisible}}">
                    <Run Text="{x:Static res:Strings.Dns_TargetOf}" /><Hyperlink Style="{StaticResource RowLink}" Command="{Binding Data.ShowRoutesCommand, Source={StaticResource Root}}" CommandParameter="{Binding}"><Run Text="{Binding UsedByRoutes, Mode=OneWay}" /></Hyperlink><Run Text="{Binding UsedByJoin, Mode=OneWay}" /><Hyperlink Style="{StaticResource RowLink}" Command="{Binding Data.ShowServicesCommand, Source={StaticResource Root}}" CommandParameter="{Binding}"><Run Text="{Binding UsedByServices, Mode=OneWay}" /></Hyperlink>
                </TextBlock>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="0,20,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <ui:TextBlock FontTypography="Subtitle" Text="DNS" />
                    <ui:TextBlock
                        Margin="12,0,0,3"
                        VerticalAlignment="Bottom"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        FontTypography="Caption"
                        Text="{Binding Summary}" />
                </StackPanel>
                <ui:TextBlock
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    FontTypography="Caption"
                    TextWrapping="Wrap"
                    Text="{x:Static res:Strings.Dns_Lead}" />
            </StackPanel>
            <ui:TextBox
                Grid.Column="1"
                Width="200"
                Margin="16,0,8,0"
                VerticalAlignment="Center"
                PlaceholderText="{x:Static res:Strings.Dns_SearchPlaceholder}"
                Icon="{ui:SymbolIcon Search24}"
                AutomationProperties.Name="{x:Static res:Strings.Dns_SearchName}"
                Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" />
            <ui:Button
                Grid.Column="2"
                Margin="0,0,8,0"
                VerticalAlignment="Center"
                Icon="{ui:SymbolIcon DocumentEdit24}"
                Content="{x:Static res:Strings.Dns_OpenHosts}"
                ToolTip="{x:Static res:Strings.Dns_OpenHostsTip}"
                Command="{Binding OpenHostsCommand}" />
            <ui:Button
                Grid.Column="3"
                VerticalAlignment="Center"
                Appearance="Primary"
                Icon="{ui:SymbolIcon Add24}"
                Content="{x:Static res:Strings.Dns_New}"
                Command="{Binding NewEntryCommand}" />
        </Grid>

        <StackPanel Grid.Row="1">
            <ui:Card Margin="0,0,0,8" Padding="16,10" Visibility="{Binding Problem, Converter={StaticResource NullToCollapsed}}">
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource SystemFillColorCautionBrush}" Text="{Binding Problem}" />
            </ui:Card>
            <ui:Card Margin="0,0,0,8" Padding="16,10" Visibility="{Binding PendingText, Converter={StaticResource NullToCollapsed}}">
                <DockPanel>
                    <ui:Button DockPanel.Dock="Right" Margin="12,0,0,0" Icon="{ui:SymbolIcon ShieldCheckmark24}" Content="{x:Static res:Strings.Common_Approve}" Command="{Binding ApprovePendingCommand}" />
                    <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding PendingText}" />
                </DockPanel>
            </ui:Card>
        </StackPanel>

        <ScrollViewer Grid.Row="2" Style="{StaticResource PageScroll}">
            <StackPanel>
                <!-- Severino's own entries -->
                <!-- No hint here: the lead above already says these work with the app closed. -->
                <ui:TextBlock Margin="0,0,0,8" FontTypography="BodyStrong" Text="{x:Static res:Strings.Dns_Own}" />
                <Border
                    Margin="0,0,0,6"
                    Padding="16,12"
                    CornerRadius="6"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    Visibility="{Binding HasOwn, Converter={StaticResource FalseToVisible}}">
                    <StackPanel>
                        <TextBlock Text="{x:Static res:Strings.Dns_OwnEmpty}" />
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Text="{x:Static res:Strings.Dns_OwnEmptyExample}" />
                    </StackPanel>
                </Border>
                <ItemsControl ItemsSource="{Binding Own}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:DnsRowViewModel}">
                            <ui:Card Margin="0,0,0,6" Padding="16,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock FontSize="14" TextTrimming="CharacterEllipsis" ToolTip="{Binding AllNames}">
                                            <Run FontWeight="SemiBold" Text="{Binding Name, Mode=OneWay}" />
                                            <Run FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding MoreNames, Mode=OneWay, StringFormat='  {0}'}" />
                                        </TextBlock>
                                        <TextBlock Style="{StaticResource Caption}">
                                            <Run FontFamily="Cascadia Mono, Consolas" Text="{Binding Address, Mode=OneWay}" />
                                            <Run Text="{Binding ScopeText, Mode=OneWay, StringFormat='   {0}'}" />
                                        </TextBlock>
                                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource UsedBy}" Focusable="False" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Margin="16,0" Style="{StaticResource StateText}" Text="{Binding StateText}" />
                                    <ui:ToggleSwitch
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        IsChecked="{Binding Enabled}"
                                        AutomationProperties.Name="{Binding Name, StringFormat={x:Static res:Strings.Common_SwitchOn}}" />
                                    <ui:Button
                                        Grid.Column="3"
                                        Margin="8,0,0,0"
                                        Appearance="Transparent"
                                        Icon="{ui:SymbolIcon MoreHorizontal24}"
                                        AutomationProperties.Name="{Binding Name, StringFormat={x:Static res:Strings.Common_MoreOptions}}"
                                        Click="OnMoreClick">
                                        <ui:Button.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="{x:Static res:Strings.Services_CopyName}" Command="{Binding Data.CopyNameCommand, Source={StaticResource Root}}" CommandParameter="{Binding}" />
                                                <MenuItem Header="{x:Static res:Strings.Common_Edit}" Command="{Binding Data.EditCommand, Source={StaticResource Root}}" CommandParameter="{Binding}" />
                                                <MenuItem
                                                    Header="{x:Static res:Strings.Dns_MakeRouteMenu}"
                                                    ToolTip="{x:Static res:Strings.Dns_MakeRouteTip}"
                                                    Command="{Binding Data.MakeRouteCommand, Source={StaticResource Root}}"
                                                    CommandParameter="{Binding}" />
                                                <Separator />
                                                <MenuItem Header="{x:Static res:Strings.Common_Remove}" Command="{Binding Data.RemoveCommand, Source={StaticResource Root}}" CommandParameter="{Binding}" />
                                            </ContextMenu>
                                        </ui:Button.ContextMenu>
                                    </ui:Button>
                                </Grid>
                            </ui:Card>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Lines from outside Severino -->
                <StackPanel Margin="0,18,0,0" Visibility="{Binding HasOutside, Converter={StaticResource TrueToVisible}}">
                    <!-- The reload sits by the title, away from the scroll bar; the long explanation is its tooltip. -->
                    <StackPanel Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal">
                            <ui:TextBlock VerticalAlignment="Center" FontTypography="BodyStrong" Text="{x:Static res:Strings.Dns_Outside}" />
                            <ui:Button
                                Margin="6,0,0,0"
                                Padding="6"
                                VerticalAlignment="Center"
                                Appearance="Transparent"
                                BorderThickness="0"
                                Icon="{ui:SymbolIcon ArrowClockwise16}"
                                ToolTip="{x:Static res:Strings.Dns_ReadAgain}"
                                AutomationProperties.Name="{x:Static res:Strings.Dns_ReadAgain}"
                                Command="{Binding ReloadCommand}" />
                        </StackPanel>
                        <ui:TextBlock
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            FontTypography="Caption"
                            TextWrapping="Wrap"
                            ToolTip="{x:Static res:Strings.Dns_OutsideHint}"
                            Text="{x:Static res:Strings.Dns_OutsideLead}" />
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding Outside}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:DnsRowViewModel}">
                                <Border
                                    Margin="0,0,0,6"
                                    Padding="14,10,16,10"
                                    CornerRadius="6"
                                    BorderThickness="1"
                                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsRemoved}" Value="True">
                                                    <Setter Property="Opacity" Value="0.6" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <!-- The caution colour only on the left edge: marked, not shouting. -->
                                        <Border
                                            Grid.Column="0"
                                            Width="3"
                                            Margin="-14,-10,0,-10"
                                            HorizontalAlignment="Left"
                                            CornerRadius="5,0,0,5"
                                            Background="{DynamicResource SystemFillColorCautionBrush}" />
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock FontSize="14" TextTrimming="CharacterEllipsis" ToolTip="{Binding AllNames}">
                                                <Run FontWeight="SemiBold" Text="{Binding Name, Mode=OneWay}" />
                                                <Run FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding MoreNames, Mode=OneWay, StringFormat='  {0}'}" />
                                                <InlineUIContainer BaselineAlignment="Center">
                                                    <Border Style="{StaticResource Badge}" Visibility="{Binding TouchedText, Converter={StaticResource NullToCollapsed}}" ToolTip="{x:Static res:Strings.Dns_TouchedTip}">
                                                        <TextBlock Style="{StaticResource BadgeText}" Text="{Binding TouchedText}" />
                                                    </Border>
                                                </InlineUIContainer>
                                            </TextBlock>
                                            <TextBlock Style="{StaticResource Caption}">
                                                <Run FontFamily="Cascadia Mono, Consolas" Text="{Binding Address, Mode=OneWay}" />
                                                <Run Text="{Binding ScopeText, Mode=OneWay, StringFormat='   {0}'}" />
                                            </TextBlock>
                                            <TextBlock Style="{StaticResource Caption}" Text="{Binding OriginText, StringFormat={x:Static res:Strings.Dns_Near}}" Visibility="{Binding OriginText, Converter={StaticResource NullToCollapsed}}" />
                                            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource UsedBy}" Focusable="False" />
                                        </StackPanel>
                                        <ui:Button
                                            Grid.Column="1"
                                            Margin="8,0,0,0"
                                            VerticalAlignment="Center"
                                            Appearance="Transparent"
                                            Icon="{ui:SymbolIcon MoreHorizontal24}"
                                            AutomationProperties.Name="{Binding Name, StringFormat={x:Static res:Strings.Dns_LineMore}}"
                                            Click="OnMoreClick">
                                            <ui:Button.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="{x:Static res:Strings.Services_CopyName}" Command="{Binding Data.CopyNameCommand, Source={StaticResource Root}}" CommandParameter="{Binding}" />
                                                    <Separator />
                                                    <MenuItem
                                                        Header="{x:Static res:Strings.Dns_EditOutsideMenu}"
                                                        IsEnabled="{Binding CanEdit}"
                                                        Command="{Binding Data.EditCommand, Source={StaticResource Root}}"
                                                        CommandParameter="{Binding}" />
                                                    <MenuItem
                                                        Header="{x:Static res:Strings.Dns_RemoveOutsideMenu}"
                                                        IsEnabled="{Binding CanEdit}"
                                                        Command="{Binding Data.RemoveCommand, Source={StaticResource Root}}"
                                                        CommandParameter="{Binding}" />
                                                    <Separator />
                                                    <MenuItem Header="{x:Static res:Strings.Dns_OpenHosts}" Command="{Binding Data.OpenHostsCommand, Source={StaticResource Root}}" />
                                                </ContextMenu>
                                            </ui:Button.ContextMenu>
                                        </ui:Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <views:PageFooter Grid.Row="3" />
    </Grid>
</UserControl>
