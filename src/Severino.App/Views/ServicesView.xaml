<UserControl
    x:Class="Severino.App.Views.ServicesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:res="clr-namespace:Severino.App.Resources"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:views="clr-namespace:Severino.App.Views"
    xmlns:vm="clr-namespace:Severino.App.ViewModels"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance Type=vm:ServicesViewModel}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Severino;component/Views/ListStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <views:BindingProxy x:Key="Root" Data="{Binding}" />
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="0,20,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16" Visibility="{Binding HasServices, Converter={StaticResource TrueToVisible}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <ui:TextBlock FontTypography="Subtitle" Text="{x:Static res:Strings.Tab_Services}" />
                    <ui:TextBlock
                        Margin="12,0,0,3"
                        VerticalAlignment="Bottom"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        FontTypography="Caption"
                        Text="{Binding Summary}" />
                </StackPanel>
                <ui:TextBlock
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    FontTypography="Caption"
                    TextWrapping="Wrap"
                    Text="{x:Static res:Strings.Services_Lead}" />
            </StackPanel>
            <ui:TextBox
                Grid.Column="1"
                Width="200"
                Margin="16,0,8,0"
                VerticalAlignment="Center"
                PlaceholderText="{x:Static res:Strings.Services_SearchPlaceholder}"
                Icon="{ui:SymbolIcon Search24}"
                AutomationProperties.Name="{x:Static res:Strings.Services_SearchName}"
                Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" />
            <ui:Button
                Grid.Column="2"
                Margin="0,0,8,0"
                VerticalAlignment="Center"
                Icon="{ui:SymbolIcon Add24}"
                Content="{x:Static res:Strings.Services_New}"
                Command="{Binding NewServiceCommand}" />
            <ui:Button
                Grid.Column="3"
                VerticalAlignment="Center"
                Appearance="Primary"
                Icon="{ui:SymbolIcon ArrowDownload24}"
                Content="{x:Static res:Strings.Common_Import}"
                ToolTip="{x:Static res:Strings.Services_ImportTip}"
                Command="{Binding ImportServicesCommand}" />
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="{Binding HasServices, Converter={StaticResource TrueToVisible}}">
            <ItemsControl ItemsSource="{Binding ServiceGroups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:ServiceGroupViewModel}">
                        <StackPanel Margin="0,0,0,10">
                            <DockPanel Margin="0,0,17,4">
                                <ui:Button
                                    DockPanel.Dock="Right"
                                    Margin="8,0,0,0"
                                    Appearance="Transparent"
                                    Icon="{ui:SymbolIcon MoreHorizontal24}"
                                    AutomationProperties.Name="{Binding Title, StringFormat={x:Static res:Strings.Common_MoreOptions}}"
                                    Click="OnMoreClick">
                                    <ui:Button.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="{x:Static res:Strings.Services_RemoveGroup}" Command="{Binding Data.RemoveGroupCommand, Source={StaticResource Root}}" CommandParameter="{Binding}" />
                                        </ContextMenu>
                                    </ui:Button.ContextMenu>
                                </ui:Button>
                                <ui:Button
                                    DockPanel.Dock="Right"
                                    Appearance="Transparent"
                                    Icon="{ui:SymbolIcon ArrowClockwise24}"
                                    Content="{x:Static res:Strings.Common_Refresh}"
                                    ToolTip="{x:Static res:Strings.Services_RefreshTip}"
                                    Command="{Binding Data.RefreshGroupCommand, Source={StaticResource Root}}"
                                    CommandParameter="{Binding}"
                                    Visibility="{Binding CanRefresh, Converter={StaticResource TrueToVisible}}" />
                                <ui:ProgressRing
                                    DockPanel.Dock="Right"
                                    Width="16"
                                    Height="16"
                                    Margin="0,0,8,0"
                                    IsIndeterminate="True"
                                    Visibility="{Binding IsRefreshing, Converter={StaticResource TrueToVisible}}" />
                                <ui:TextBlock
                                    VerticalAlignment="Center"
                                    FontTypography="BodyStrong"
                                    TextTrimming="CharacterEllipsis"
                                    Text="{Binding Title}" />
                            </DockPanel>
                            <ItemsControl ItemsSource="{Binding Items}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:ServiceItemViewModel}">
                                        <ui:Card Margin="0,0,0,6" Padding="16,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="24" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Style="{StaticResource HealthDot}" />
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock FontSize="14" TextTrimming="CharacterEllipsis" ToolTip="{Binding AllNames}">
                                                        <Run FontWeight="SemiBold" Text="{Binding Name, Mode=OneWay}" />
                                                        <Run FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding MoreNames, Mode=OneWay, StringFormat='  {0}'}" />
                                                        <Run FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding Namespace, Mode=OneWay, StringFormat='  ·  {0}'}" />
                                                    </TextBlock>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Style="{StaticResource RowCaption}" Text="{Binding Detail}" ToolTip="{Binding DetailTooltip}" />
                                                        <TextBlock
                                                            Margin="12,0,0,0"
                                                            Style="{StaticResource RowCaption}"
                                                            ToolTip="{x:Static res:Strings.Routes_ShowInDnsTip}"
                                                            Visibility="{Binding DestinationText, Converter={StaticResource NullToCollapsed}}">
                                                            <Hyperlink Style="{StaticResource RowLink}" Command="{Binding Data.ShowDnsCommand, Source={StaticResource Root}}" CommandParameter="{Binding Destination.Name}">
                                                                <Run Text="{Binding DestinationText, Mode=OneWay}" />
                                                            </Hyperlink>
                                                        </TextBlock>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding ForwardText}" ToolTip="{Binding ForwardText}" Visibility="{Binding ForwardText, Converter={StaticResource NullToCollapsed}}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock" BasedOn="{StaticResource RowCaption}">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding ForwardProblem}" Value="True">
                                                                        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                                <TextBlock
                                                    Grid.Column="2"
                                                    Margin="16,0"
                                                    Style="{StaticResource HealthLabel}"
                                                    Text="{Binding HealthText}" />
                                                <ui:ToggleSwitch
                                                    Grid.Column="3"
                                                    VerticalAlignment="Center"
                                                    IsChecked="{Binding Enabled}"
                                                    AutomationProperties.Name="{Binding Name, StringFormat={x:Static res:Strings.Common_SwitchOn}}" />
                                                <ui:Button
                                                    Grid.Column="4"
                                                    Margin="8,0,0,0"
                                                    Appearance="Transparent"
                                                    Icon="{ui:SymbolIcon MoreHorizontal24}"
                                                    AutomationProperties.Name="{Binding Name, StringFormat={x:Static res:Strings.Common_MoreOptions}}"
                                                    Click="OnMoreClick">
                                                    <ui:Button.ContextMenu>
                                                        <ContextMenu>
                                                            <MenuItem Header="{x:Static res:Strings.Services_CopyName}" Command="{Binding Data.CopyServiceNameCommand, Source={StaticResource Root}}" CommandParameter="{Binding}" />
                                                            <MenuItem Header="{x:Static res:Strings.Common_Edit}" Command="{Binding Data.EditServiceCommand, Source={StaticResource Root}}" CommandParameter="{Binding}" />
                                                            <Separator />
                                                            <MenuItem Header="{x:Static res:Strings.Common_Remove}" Command="{Binding Data.RemoveServiceCommand, Source={StaticResource Root}}" CommandParameter="{Binding}" />
                                                        </ContextMenu>
                                                    </ui:Button.ContextMenu>
                                                </ui:Button>
                                            </Grid>
                                        </ui:Card>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="{Binding IsEmpty, Converter={StaticResource TrueToVisible}}">
            <StackPanel MaxWidth="520" Margin="0,8" HorizontalAlignment="Center" VerticalAlignment="Center">
                <ui:TextBlock
                    Margin="0,0,0,4"
                    HorizontalAlignment="Center"
                    FontTypography="Subtitle"
                    Text="{x:Static res:Strings.Services_EmptyTitle}" />
                <ui:TextBlock
                    Margin="0,0,0,16"
                    HorizontalAlignment="Center"
                    TextAlignment="Center"
                    TextWrapping="Wrap"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="{x:Static res:Strings.Services_EmptyText}" />
                <views:NameKindsPanel />
                <StackPanel Margin="0,16,0,0" HorizontalAlignment="Center" Orientation="Horizontal">
                    <ui:Button
                        Appearance="Primary"
                        Icon="{ui:SymbolIcon ArrowDownload24}"
                        Content="{x:Static res:Strings.Services_ImportFirst}"
                        Command="{Binding ImportServicesCommand}" />
                    <ui:Button
                        Margin="8,0,0,0"
                        Icon="{ui:SymbolIcon Add24}"
                        Content="{x:Static res:Strings.Services_CreateByHand}"
                        Command="{Binding NewServiceCommand}" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <views:PageFooter Grid.Row="2" />
    </Grid>
</UserControl>
