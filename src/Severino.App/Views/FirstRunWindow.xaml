<ui:FluentWindow
    x:Class="Severino.App.Views.FirstRunWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:views="clr-namespace:Severino.App.Views"
    xmlns:vm="clr-namespace:Severino.App.ViewModels"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance Type=vm:FirstRunViewModel}"
    Title="Bem-vindo ao Severino"
    Width="600"
    SizeToContent="Height"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    WindowBackdropType="Mica"
    Icon="/Assets/severino.ico"
    ExtendsContentIntoTitleBar="True">
    <ui:FluentWindow.Resources>
        <!-- The mark reads on its own; colour only backs it up. -->
        <Style x:Key="CheckMark" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Text" Value="…" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="Ok">
                    <Setter Property="Text" Value="✓" />
                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Warning">
                    <Setter Property="Text" Value="!" />
                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Problem">
                    <Setter Property="Text" Value="✗" />
                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </ui:FluentWindow.Resources>

    <StackPanel>
        <ui:TitleBar Title="Bem-vindo ao Severino" ShowMaximize="False" ShowMinimize="False" />

        <StackPanel Margin="24,8,24,24">
            <DockPanel>
                <Image
                    Width="64"
                    Height="64"
                    DockPanel.Dock="Left"
                    Source="/Assets/severino-512.png"
                    RenderOptions.BitmapScalingMode="HighQuality"
                    AutomationProperties.Name="Severino" />
                <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                    <ui:TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontTypography="Caption" Text="{Binding StepText}" />
                    <ui:TextBlock FontTypography="Subtitle" Text="O Severino está na portaria" />
                    <ui:TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Text="{Binding Subtitle}" />
                </StackPanel>
            </DockPanel>

            <!-- Step 1: the check. -->
            <ItemsControl Margin="0,20,0,0" ItemsSource="{Binding Checks}" Visibility="{Binding IsCheckStep, Converter={StaticResource TrueToVisible}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:SetupCheck}">
                        <ui:Card Margin="0,0,0,6" Padding="16,12">
                            <DockPanel>
                                <TextBlock Width="28" DockPanel.Dock="Left" VerticalAlignment="Top" Style="{StaticResource CheckMark}" />
                                <ui:Button
                                    Margin="12,0,0,0"
                                    VerticalAlignment="Center"
                                    DockPanel.Dock="Right"
                                    Content="{Binding FixLabel}"
                                    Command="{Binding FixCommand}"
                                    Visibility="{Binding FixLabel, Converter={StaticResource NullToCollapsed}}" />
                                <StackPanel>
                                    <ui:TextBlock FontTypography="BodyStrong" Text="{Binding Title}" />
                                    <ui:TextBlock
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        FontTypography="Caption"
                                        TextWrapping="Wrap"
                                        Text="{Binding Detail}"
                                        AutomationProperties.LiveSetting="Polite" />
                                </StackPanel>
                            </DockPanel>
                        </ui:Card>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Step 2: the first route. -->
            <StackPanel Margin="0,20,0,0" Visibility="{Binding IsRouteStep, Converter={StaticResource TrueToVisible}}">
                <views:RouteForm x:Name="Form" DataContext="{Binding Route}" />
                <CheckBox Margin="0,16,0,0" IsChecked="{Binding UseHttps}" Content="Usar HTTPS" />
                <ui:TextBlock
                    Margin="28,0,0,0"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    FontTypography="Caption"
                    TextWrapping="Wrap"
                    Text="O Severino cria uma CA local que só assina os seus domínios, e o Windows pede para confirmar a instalação. Dá para ativar depois, em Configurações." />
            </StackPanel>

            <DockPanel Margin="0,24,0,0">
                <ui:Button DockPanel.Dock="Left" Appearance="Transparent" Content="Pular" Command="{Binding SkipCommand}" />
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <ui:ProgressRing
                        Width="20"
                        Height="20"
                        Margin="0,0,12,0"
                        IsIndeterminate="True"
                        Visibility="{Binding IsBusy, Converter={StaticResource TrueToVisible}}" />
                    <ui:Button
                        MinWidth="120"
                        Appearance="Primary"
                        Content="Continuar"
                        Command="{Binding ContinueCommand}"
                        Visibility="{Binding IsCheckStep, Converter={StaticResource TrueToVisible}}" />
                    <ui:Button
                        MinWidth="120"
                        Appearance="Primary"
                        IsDefault="True"
                        Content="{Binding CreateLabel}"
                        Command="{Binding CreateCommand}"
                        Visibility="{Binding IsRouteStep, Converter={StaticResource TrueToVisible}}" />
                </StackPanel>
            </DockPanel>
        </StackPanel>
    </StackPanel>
</ui:FluentWindow>
