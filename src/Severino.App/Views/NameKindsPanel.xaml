<UserControl
    x:Class="Severino.App.Views.NameKindsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:res="clr-namespace:Severino.App.Resources"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <!-- In each empty tab: the three ways to give a name, so the first one made is the right kind. -->
    <ui:Card Padding="16,12">
        <StackPanel>
            <ui:TextBlock Margin="0,0,0,8" FontTypography="BodyStrong" Text="{x:Static res:Strings.Kinds_Title}" />
            <TextBlock Margin="0,0,0,6" TextWrapping="Wrap">
                <Run FontWeight="SemiBold" Text="{x:Static res:Strings.Kinds_Route}" />
                <Run Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{x:Static res:Strings.Kinds_RouteText}" />
            </TextBlock>
            <TextBlock Margin="0,0,0,6" TextWrapping="Wrap">
                <Run FontWeight="SemiBold" Text="{x:Static res:Strings.Kinds_Service}" />
                <Run Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{x:Static res:Strings.Kinds_ServiceText}" />
            </TextBlock>
            <TextBlock TextWrapping="Wrap">
                <Run FontWeight="SemiBold" Text="{x:Static res:Strings.Kinds_Dns}" />
                <Run Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{x:Static res:Strings.Kinds_DnsText}" />
            </TextBlock>
        </StackPanel>
    </ui:Card>
</UserControl>
