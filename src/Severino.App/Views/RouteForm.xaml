<UserControl
    x:Class="Severino.App.Views.RouteForm"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:Severino.App.ViewModels"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance Type=vm:RouteEditorViewModel}">
    <UserControl.Resources>
        <Style x:Key="FieldLabel" TargetType="ui:TextBlock">
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="FontTypography" Value="BodyStrong" />
        </Style>
        <Style x:Key="Hint" TargetType="ui:TextBlock">
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="FontTypography" Value="Caption" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="ErrorText" TargetType="ui:TextBlock">
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
        </Style>
    </UserControl.Resources>

    <!-- The route fields, shared by the route editor and the first-run wizard. -->
    <StackPanel>
        <ui:TextBlock Style="{StaticResource FieldLabel}" Text="Endereço" />
        <ui:TextBox
            x:Name="DomainBox"
            PlaceholderText="ex.: callfred.sev"
            AutomationProperties.Name="Endereço"
            Text="{Binding Domain, UpdateSourceTrigger=PropertyChanged}" />
        <ui:TextBlock
            Style="{StaticResource Hint}"
            Text="Qualquer nome vale; .test e .localhost nunca colidem com a internet. *.callfred.sev atende os nomes abaixo dele, e callfred.sev/api fica só com esse caminho." />
        <ui:TextBlock Style="{StaticResource ErrorText}" Text="{Binding DomainError}" Visibility="{Binding DomainError, Converter={StaticResource NullToCollapsed}}" />
        <ItemsControl Margin="0,4,0,0" ItemsSource="{Binding DomainWarnings}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <ui:InfoBar
                        Margin="0,4,0,0"
                        IsOpen="True"
                        IsClosable="False"
                        Severity="Warning"
                        Message="{Binding Message}"
                        AutomationProperties.Name="{Binding Message}"
                        AutomationProperties.LiveSetting="Polite" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <!-- Only with a path: whether the destination sees it. -->
        <StackPanel Margin="0,8,0,0" Visibility="{Binding HasPath, Converter={StaticResource TrueToVisible}}">
            <CheckBox Content="{Binding Path}" ContentStringFormat="Tirar {0} antes de repassar" IsChecked="{Binding StripPath}" />
            <ui:TextBlock Margin="28,0,0,0" Style="{StaticResource Hint}" Text="{Binding Path, StringFormat='Ligado, {0}/pedidos chega ao destino como /pedidos.'}" />
        </StackPanel>

        <ui:TextBlock Margin="0,16,0,6" Style="{StaticResource FieldLabel}" Text="Destino" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="104" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="96" />
            </Grid.ColumnDefinitions>
            <ComboBox Grid.Column="0" ItemsSource="{Binding Schemes}" SelectedItem="{Binding Scheme}" AutomationProperties.Name="Protocolo do destino" />
            <ui:TextBlock Grid.Column="1" Margin="6,0" VerticalAlignment="Center" Text="://" />
            <!-- Editable, with the names in the hosts as suggestions: a route to a DNS name follows
                 it when its address changes in the DNS tab. -->
            <ComboBox
                Grid.Column="2"
                IsEditable="True"
                IsTextSearchEnabled="False"
                TextSearch.TextPath="Name"
                ItemsSource="{Binding HostSuggestions}"
                Text="{Binding TargetHost, UpdateSourceTrigger=PropertyChanged}"
                ToolTip="localhost, um IP ou um nome do DNS"
                AutomationProperties.Name="Host do destino">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock Text="{Binding Name}" />
                            <TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Detail}" />
                        </StackPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <ui:TextBlock Grid.Column="3" Margin="6,0" VerticalAlignment="Center" Text=":" />
            <!-- Editable: any number works; the list only saves remembering it. No autocomplete,
                 which would turn a typed "50" into "5000". -->
            <ComboBox
                Grid.Column="4"
                IsEditable="True"
                IsTextSearchEnabled="False"
                TextSearch.TextPath="PortText"
                ItemsSource="{Binding Ports}"
                Text="{Binding TargetPort, UpdateSourceTrigger=PropertyChanged}"
                DropDownOpened="OnPortsOpening"
                ToolTip="Portas com algum programa escutando agora"
                AutomationProperties.Name="Porta do destino">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Label}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </Grid>
        <ui:TextBlock Style="{StaticResource ErrorText}" Text="{Binding TargetError}" Visibility="{Binding TargetError, Converter={StaticResource NullToCollapsed}}" />
        <ui:TextBlock
            Margin="0,4,0,0"
            TextWrapping="Wrap"
            Foreground="{DynamicResource SystemFillColorCautionBrush}"
            Text="{Binding PortWarning}"
            Visibility="{Binding PortWarning, Converter={StaticResource NullToCollapsed}}" />

        <!-- This looks like a service or a DNS entry: says why, and makes one from what was typed. -->
        <ui:Card Margin="0,8,0,0" Padding="14,10" Visibility="{Binding KindHint, Converter={StaticResource NullToCollapsed}}">
            <DockPanel>
                <ui:Button DockPanel.Dock="Right" Margin="12,0,0,0" VerticalAlignment="Center" Content="{Binding KindSwitchLabel}" Command="{Binding SwitchKindCommand}" />
                <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding KindHint}" AutomationProperties.LiveSetting="Polite" />
            </DockPanel>
        </ui:Card>

        <StackPanel Visibility="{Binding IsWizard, Converter={StaticResource FalseToVisible}}">
            <ui:TextBlock Margin="0,16,0,6" Style="{StaticResource FieldLabel}" Text="Grupo (opcional)" />
            <ComboBox
                IsEditable="True"
                IsTextSearchEnabled="False"
                ItemsSource="{Binding GroupSuggestions}"
                Text="{Binding Group, UpdateSourceTrigger=PropertyChanged}"
                AutomationProperties.Name="Grupo" />
            <ui:TextBlock
                Style="{StaticResource Hint}"
                Text="Rotas do mesmo grupo aparecem juntas e ligam ou desligam de uma vez, como callfred para o app e a API." />
        </StackPanel>

        <!-- The first-run wizard asks about HTTPS its own way, before the CA exists. -->
        <StackPanel Margin="0,16,0,0" Visibility="{Binding ShowHttpsOptions, Converter={StaticResource TrueToVisible}}">
            <CheckBox Content="Usar HTTPS, com certificado da CA local" IsChecked="{Binding Https}" IsEnabled="{Binding CanToggleHttps}" />
            <CheckBox Content="Redirecionar HTTP para HTTPS" IsChecked="{Binding RedirectToHttps}" IsEnabled="{Binding CanToggleRedirect}" />
            <ui:TextBlock
                Style="{StaticResource Hint}"
                Text="{Binding HttpsRequiredText}"
                Visibility="{Binding HttpsRequiredText, Converter={StaticResource NullToCollapsed}}" />
            <TextBlock
                Margin="0,4,0,0"
                FontSize="12"
                TextWrapping="Wrap"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Visibility="{Binding HttpsAvailable, Converter={StaticResource FalseToVisible}}">
                <Run Text="O HTTPS está desativado." />
                <Hyperlink Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Command="{Binding OpenHttpsSettingsCommand}">Ativar em Configurações</Hyperlink>
            </TextBlock>
            <ui:InfoBar
                Margin="0,8,0,0"
                IsOpen="True"
                IsClosable="False"
                Severity="Warning"
                Message="{Binding CoverageWarning}"
                Visibility="{Binding CoverageWarning, Converter={StaticResource NullToCollapsed}}"
                AutomationProperties.LiveSetting="Polite" />
        </StackPanel>

        <Expander Margin="0,16,0,0" Header="Avançado" IsExpanded="{Binding ShowAdvanced}">
            <StackPanel Margin="0,8,0,0">
                <CheckBox Content="Preservar o Host original" IsChecked="{Binding PreserveHost}" />
                <ui:TextBlock
                    Margin="28,0,0,8"
                    Style="{StaticResource Hint}"
                    Text="Para apps que geram URLs absolutas. Desligado, o destino recebe o próprio host, o que agrada o Vite e o webpack." />
                <CheckBox Content="Ignorar certificado inválido do destino" IsChecked="{Binding IgnoreTargetCertErrors}" />
                <ui:TextBlock
                    Margin="28,0,0,8"
                    Style="{StaticResource Hint}"
                    Text="Útil para destinos https de desenvolvimento, como o https://localhost:5001 do ASP.NET." />
                <ui:TextBox
                    MinHeight="64"
                    AcceptsReturn="True"
                    TextWrapping="Wrap"
                    PlaceholderText="Observações"
                    AutomationProperties.Name="Observações"
                    Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
        </Expander>
    </StackPanel>
</UserControl>
