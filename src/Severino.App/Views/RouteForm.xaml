<UserControl
    x:Class="Severino.App.Views.RouteForm"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:res="clr-namespace:Severino.App.Resources"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:views="clr-namespace:Severino.App.Views"
    xmlns:vm="clr-namespace:Severino.App.ViewModels"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance Type=vm:RouteEditorViewModel}">
    <UserControl.Resources>
        <Style x:Key="FieldLabel" TargetType="ui:TextBlock">
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="FontTypography" Value="BodyStrong" />
        </Style>
        <Style x:Key="Hint" TargetType="ui:TextBlock">
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="FontTypography" Value="Caption" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="ErrorText" TargetType="ui:TextBlock">
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
        </Style>
    </UserControl.Resources>

    <!-- The route fields, shared by the route editor and the first-run wizard. -->
    <StackPanel>
        <ui:TextBlock Style="{StaticResource FieldLabel}" Text="{x:Static res:Strings.RouteForm_Address}" />
        <ui:TextBox
            x:Name="DomainBox"
            PlaceholderText="{x:Static res:Strings.RouteForm_AddressPlaceholder}"
            AutomationProperties.Name="{x:Static res:Strings.RouteForm_Address}"
            views:Cleanup.As="Address"
            Text="{Binding Domain, UpdateSourceTrigger=PropertyChanged}" />
        <ui:TextBlock
            Style="{StaticResource Hint}"
            Text="{x:Static res:Strings.RouteForm_AddressHint}" />
        <ui:TextBlock Style="{StaticResource ErrorText}" Text="{Binding DomainError}" Visibility="{Binding DomainError, Converter={StaticResource NullToCollapsed}}" />
        <ItemsControl Margin="0,4,0,0" ItemsSource="{Binding DomainWarnings}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <ui:InfoBar
                        Margin="0,4,0,0"
                        IsOpen="True"
                        IsClosable="False"
                        Severity="Warning"
                        Message="{Binding Message}"
                        AutomationProperties.Name="{Binding Message}"
                        AutomationProperties.LiveSetting="Polite" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <!-- Only with a path: whether the destination sees it. -->
        <StackPanel Margin="0,8,0,0" Visibility="{Binding CanStripPath, Converter={StaticResource TrueToVisible}}">
            <CheckBox Content="{Binding Path}" ContentStringFormat="{x:Static res:Strings.RouteForm_StripPath}" IsChecked="{Binding StripPath}" />
            <ui:TextBlock Margin="28,0,0,0" Style="{StaticResource Hint}" Text="{Binding Path, StringFormat={x:Static res:Strings.RouteForm_StripPathHint}}" />
        </StackPanel>

        <ui:TextBlock Margin="0,16,0,6" Style="{StaticResource FieldLabel}" Text="{x:Static res:Strings.ServiceEditor_Target}" />
        <!-- A server to forward to, or a folder Severino serves itself. -->
        <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
            <RadioButton Content="{x:Static res:Strings.RouteForm_TargetServer}" GroupName="TargetKind" IsChecked="{Binding IsServer}" />
            <RadioButton Margin="16,0,0,0" Content="{x:Static res:Strings.RouteForm_TargetFolder}" GroupName="TargetKind" IsChecked="{Binding IsFolder}" />
        </StackPanel>
        <StackPanel Visibility="{Binding IsFolder, Converter={StaticResource TrueToVisible}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:TextBox
                    PlaceholderText="{x:Static res:Strings.RouteForm_FolderPlaceholder}"
                    AutomationProperties.Name="{x:Static res:Strings.RouteForm_TargetFolder}"
                    Text="{Binding FolderPath, UpdateSourceTrigger=PropertyChanged}" />
                <ui:Button
                    Grid.Column="1"
                    Margin="8,0,0,0"
                    VerticalAlignment="Stretch"
                    Icon="{ui:SymbolIcon FolderOpen24}"
                    Content="{x:Static res:Strings.RouteForm_PickFolderButton}"
                    Command="{Binding PickFolderCommand}" />
            </Grid>
            <CheckBox Margin="0,8,0,0" Content="{x:Static res:Strings.RouteForm_SpaFallback}" IsChecked="{Binding SpaFallback}" />
            <ui:TextBlock Margin="28,0,0,0" Style="{StaticResource Hint}" Text="{x:Static res:Strings.RouteForm_SpaFallbackHint}" />
        </StackPanel>
        <Grid Visibility="{Binding IsServer, Converter={StaticResource TrueToVisible}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="104" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="96" />
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="SchemeBox" Grid.Column="0" ItemsSource="{Binding Schemes}" SelectedItem="{Binding Scheme}" AutomationProperties.Name="{x:Static res:Strings.RouteForm_SchemeName}" />
            <ui:TextBlock Grid.Column="1" Margin="6,0" VerticalAlignment="Center" Text="://" />
            <!-- Editable, with the names in the hosts as suggestions: a route to a DNS name follows
                 it when its address changes in the DNS tab. -->
            <ComboBox
                Grid.Column="2"
                IsEditable="True"
                IsTextSearchEnabled="False"
                TextSearch.TextPath="Name"
                ItemsSource="{Binding HostSuggestions}"
                Text="{Binding TargetHost, UpdateSourceTrigger=PropertyChanged}"
                views:Cleanup.As="Host"
                views:Cleanup.PortBox="{Binding ElementName=TargetPortBox}"
                views:Cleanup.SchemeBox="{Binding ElementName=SchemeBox}"
                ToolTip="{x:Static res:Strings.RouteForm_HostTip}"
                AutomationProperties.Name="{x:Static res:Strings.RouteForm_HostName}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock Text="{Binding Name}" />
                            <TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Detail}" />
                        </StackPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <ui:TextBlock Grid.Column="3" Margin="6,0" VerticalAlignment="Center" Text=":" />
            <!-- Editable: any number works; the list only saves remembering it. No autocomplete,
                 which would turn a typed "50" into "5000". -->
            <ComboBox
                x:Name="TargetPortBox"
                Grid.Column="4"
                views:Cleanup.As="Port"
                IsEditable="True"
                IsTextSearchEnabled="False"
                TextSearch.TextPath="PortText"
                ItemsSource="{Binding Ports}"
                Text="{Binding TargetPort, UpdateSourceTrigger=PropertyChanged}"
                DropDownOpened="OnPortsOpening"
                ToolTip="{x:Static res:Strings.RouteForm_PortsTip}"
                AutomationProperties.Name="{x:Static res:Strings.ServiceEditor_TargetPortName}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Label}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </Grid>
        <ui:TextBlock Style="{StaticResource ErrorText}" Text="{Binding TargetError}" Visibility="{Binding TargetError, Converter={StaticResource NullToCollapsed}}" />
        <ui:TextBlock
            Margin="0,4,0,0"
            TextWrapping="Wrap"
            Foreground="{DynamicResource SystemFillColorCautionBrush}"
            Text="{Binding PortWarning}"
            Visibility="{Binding PortWarning, Converter={StaticResource NullToCollapsed}}" />

        <!-- This looks like a service or a DNS entry: says why, and makes one from what was typed. -->
        <ui:Card Margin="0,8,0,0" Padding="14,10" Visibility="{Binding KindHint, Converter={StaticResource NullToCollapsed}}">
            <DockPanel>
                <ui:Button DockPanel.Dock="Right" Margin="12,0,0,0" VerticalAlignment="Center" Content="{Binding KindSwitchLabel}" Command="{Binding SwitchKindCommand}" />
                <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding KindHint}" AutomationProperties.LiveSetting="Polite" />
            </DockPanel>
        </ui:Card>

        <!-- Group and environment side by side: both optional, both a label shared by several items. -->
        <Grid Margin="0,16,0,0" Visibility="{Binding IsWizard, Converter={StaticResource FalseToVisible}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <ui:TextBlock Style="{StaticResource FieldLabel}" Text="{x:Static res:Strings.RouteForm_Group}" />
                <ComboBox
                    IsEditable="True"
                    IsTextSearchEnabled="False"
                    ItemsSource="{Binding GroupSuggestions}"
                    Text="{Binding Group, UpdateSourceTrigger=PropertyChanged}"
                    AutomationProperties.Name="{x:Static res:Strings.RouteForm_GroupName}" />
                <ui:TextBlock Style="{StaticResource Hint}" Text="{x:Static res:Strings.RouteForm_GroupHint}" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <ui:TextBlock Style="{StaticResource FieldLabel}" Text="{x:Static res:Strings.Env_Field}" />
                <ComboBox
                    IsEditable="True"
                    IsTextSearchEnabled="False"
                    ItemsSource="{Binding EnvironmentSuggestions}"
                    Text="{Binding Environment, UpdateSourceTrigger=PropertyChanged}"
                    AutomationProperties.Name="{x:Static res:Strings.Env_FieldName}" />
                <ui:TextBlock Style="{StaticResource Hint}" Text="{x:Static res:Strings.Env_FieldHint}" />
            </StackPanel>
        </Grid>


        <!-- The first-run wizard asks about HTTPS its own way, before the CA exists. -->
        <StackPanel Margin="0,16,0,0" Visibility="{Binding ShowHttpsOptions, Converter={StaticResource TrueToVisible}}">
            <CheckBox Content="{x:Static res:Strings.RouteForm_UseHttps}" IsChecked="{Binding Https}" IsEnabled="{Binding CanToggleHttps}" />
            <CheckBox Content="{x:Static res:Strings.RouteForm_Redirect}" IsChecked="{Binding RedirectToHttps}" IsEnabled="{Binding CanToggleRedirect}" />
            <ui:TextBlock
                Style="{StaticResource Hint}"
                Text="{Binding HttpsRequiredText}"
                Visibility="{Binding HttpsRequiredText, Converter={StaticResource NullToCollapsed}}" />
            <TextBlock
                Margin="0,4,0,0"
                FontSize="12"
                TextWrapping="Wrap"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Visibility="{Binding HttpsAvailable, Converter={StaticResource FalseToVisible}}">
                <Run Text="{x:Static res:Strings.RouteForm_HttpsOff}" />
                <Hyperlink Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Command="{Binding OpenHttpsSettingsCommand}"><Run Text="{x:Static res:Strings.RouteForm_TurnOnInSettings}" /></Hyperlink>
            </TextBlock>
            <ui:InfoBar
                Margin="0,8,0,0"
                IsOpen="True"
                IsClosable="False"
                Severity="Warning"
                Message="{Binding CoverageWarning}"
                Visibility="{Binding CoverageWarning, Converter={StaticResource NullToCollapsed}}"
                AutomationProperties.LiveSetting="Polite" />
        </StackPanel>

        <Expander Margin="0,16,0,0" Header="{x:Static res:Strings.RouteForm_Advanced}" IsExpanded="{Binding ShowAdvanced}">
            <StackPanel Margin="0,8,0,0">
                <CheckBox Content="{x:Static res:Strings.RouteForm_PreserveHost}" IsChecked="{Binding PreserveHost}" />
                <ui:TextBlock
                    Margin="28,0,0,8"
                    Style="{StaticResource Hint}"
                    Text="{x:Static res:Strings.RouteForm_PreserveHostHint}" />
                <CheckBox Content="{x:Static res:Strings.RouteForm_IgnoreCert}" IsChecked="{Binding IgnoreTargetCertErrors}" />
                <ui:TextBlock
                    Margin="28,0,0,8"
                    Style="{StaticResource Hint}"
                    Text="{x:Static res:Strings.RouteForm_IgnoreCertHint}" />
                <CheckBox Content="{x:Static res:Strings.Health_Notify}" IsChecked="{Binding NotifyHealth}" />
                <ui:TextBlock
                    Margin="28,0,0,8"
                    Style="{StaticResource Hint}"
                    Text="{x:Static res:Strings.Health_NotifyHint}" />

                <ui:TextBox
                    Margin="0,16,0,0"

                    MinHeight="64"
                    AcceptsReturn="True"
                    TextWrapping="Wrap"
                    PlaceholderText="{x:Static res:Strings.Common_Remarks}"
                    AutomationProperties.Name="{x:Static res:Strings.Common_Remarks}"
                    Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
        </Expander>

        <!-- What the proxy does to the traffic: shown on the route's card while on. -->
        <Expander Margin="0,8,0,0" Header="{x:Static res:Strings.Rules_Title}" IsExpanded="{Binding ShowRules}">
            <StackPanel Margin="0,8,0,0">
                <CheckBox Content="{x:Static res:Strings.Rules_Cors}" IsChecked="{Binding Cors}" />
                <ui:TextBlock
                    Margin="28,0,0,8"
                    Style="{StaticResource Hint}"
                    Text="{x:Static res:Strings.Rules_CorsHint}" />                <TextBlock Margin="0,8,0,4" Text="{x:Static res:Strings.Rules_RequestHeaders}" />
                <ItemsControl ItemsSource="{Binding RequestHeaders}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:HeaderRuleRow}">
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="3*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:TextBox
                                    Margin="0,0,6,0"
                                    PlaceholderText="{x:Static res:Strings.Rules_HeaderName}"
                                    AutomationProperties.Name="{x:Static res:Strings.Rules_HeaderName}"
                                    Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                                <ui:TextBox
                                    Grid.Column="1"
                                    PlaceholderText="{x:Static res:Strings.Rules_HeaderValue}"
                                    AutomationProperties.Name="{x:Static res:Strings.Rules_HeaderValue}"
                                    Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" />
                                <ui:Button
                                    Grid.Column="2"
                                    Margin="4,0,0,0"
                                    VerticalAlignment="Center"
                                    Appearance="Transparent"
                                    Icon="{ui:SymbolIcon Dismiss16}"
                                    AutomationProperties.Name="{Binding Name, StringFormat={x:Static res:Strings.Rules_RemoveHeader}}"
                                    Command="{Binding DataContext.RemoveHeaderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ui:Button
                    HorizontalAlignment="Left"
                    Appearance="Transparent"
                    Icon="{ui:SymbolIcon Add16}"
                    Content="{x:Static res:Strings.Rules_AddHeader}"
                    Command="{Binding AddRequestHeaderCommand}" />
                <TextBlock Margin="0,8,0,4" Text="{x:Static res:Strings.Rules_ResponseHeaders}" />
                <ItemsControl ItemsSource="{Binding ResponseHeaders}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:HeaderRuleRow}">
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="3*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:TextBox
                                    Margin="0,0,6,0"
                                    PlaceholderText="{x:Static res:Strings.Rules_HeaderName}"
                                    AutomationProperties.Name="{x:Static res:Strings.Rules_HeaderName}"
                                    Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                                <ui:TextBox
                                    Grid.Column="1"
                                    PlaceholderText="{x:Static res:Strings.Rules_HeaderValue}"
                                    AutomationProperties.Name="{x:Static res:Strings.Rules_HeaderValue}"
                                    Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" />
                                <ui:Button
                                    Grid.Column="2"
                                    Margin="4,0,0,0"
                                    VerticalAlignment="Center"
                                    Appearance="Transparent"
                                    Icon="{ui:SymbolIcon Dismiss16}"
                                    AutomationProperties.Name="{Binding Name, StringFormat={x:Static res:Strings.Rules_RemoveHeader}}"
                                    Command="{Binding DataContext.RemoveHeaderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ui:Button
                    HorizontalAlignment="Left"
                    Appearance="Transparent"
                    Icon="{ui:SymbolIcon Add16}"
                    Content="{x:Static res:Strings.Rules_AddHeader}"
                    Command="{Binding AddResponseHeaderCommand}" />
                <ui:TextBlock Style="{StaticResource Hint}" Text="{x:Static res:Strings.Rules_HeadersHint}" />

                <WrapPanel Margin="0,12,0,0">
                    <TextBlock Margin="0,0,8,0" VerticalAlignment="Center" Text="{x:Static res:Strings.Rules_Delay}" />
                    <ui:TextBox
                        Width="96"
                        PlaceholderText="0"
                        AutomationProperties.Name="{x:Static res:Strings.Rules_Delay}"
                        Text="{Binding DelayText, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" Text="ms" />
                </WrapPanel>
                <WrapPanel Margin="0,8,0,0">
                    <TextBlock Margin="0,0,8,0" VerticalAlignment="Center" Text="{x:Static res:Strings.Rules_Fail}" />
                    <ComboBox
                        MinWidth="88"
                        ItemsSource="{Binding FailStatuses}"
                        SelectedItem="{Binding FailStatus}"
                        AutomationProperties.Name="{x:Static res:Strings.Rules_FailStatus}" />
                    <TextBlock Margin="8,0" VerticalAlignment="Center" Text="{x:Static res:Strings.Rules_FailIn}" />
                    <ui:TextBox
                        Width="72"
                        PlaceholderText="0"
                        AutomationProperties.Name="{x:Static res:Strings.Rules_FailPercent}"
                        Text="{Binding FailPercentText, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" Text="{x:Static res:Strings.Rules_FailOf}" />
                </WrapPanel>
                <TextBlock
                    Margin="0,8,0,0"
                    TextWrapping="Wrap"
                    Foreground="{DynamicResource SystemFillColorCautionBrush}"
                    Text="{Binding RulesError}"
                    Visibility="{Binding RulesError, Converter={StaticResource NullToCollapsed}}"
                    AutomationProperties.LiveSetting="Assertive" />
            </StackPanel>
        </Expander>
    </StackPanel>
</UserControl>
