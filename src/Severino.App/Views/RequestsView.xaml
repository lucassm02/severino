<UserControl
    x:Class="Severino.App.Views.RequestsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:views="clr-namespace:Severino.App.Views"
    xmlns:vm="clr-namespace:Severino.App.ViewModels"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance Type=vm:RequestsViewModel}">
    <UserControl.Resources>
        <views:BindingProxy x:Key="Root" Data="{Binding}" />

        <!-- The status reads on its own; colour only groups the ranges. -->
        <Style x:Key="StatusText" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding StatusClass}" Value="Success">
                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusClass}" Value="Redirect">
                    <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusClass}" Value="ClientError">
                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusClass}" Value="ServerError">
                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="0,20,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <ui:TextBlock FontTypography="Subtitle" Text="Requisições" />
                <ui:TextBlock
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    FontTypography="Caption"
                    Text="As últimas 1000, só em memória. Nada vai para o disco." />
            </StackPanel>
            <ui:TextBlock
                Grid.Column="1"
                Margin="0,0,12,0"
                VerticalAlignment="Center"
                Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                Text="{Binding HeldText}"
                Visibility="{Binding HeldText, Converter={StaticResource NullToCollapsed}}"
                AutomationProperties.LiveSetting="Polite" />
            <ComboBox
                Grid.Column="2"
                MinWidth="200"
                Margin="0,0,8,0"
                VerticalAlignment="Center"
                ItemsSource="{Binding Domains}"
                SelectedItem="{Binding SelectedDomain}"
                DisplayMemberPath="Label"
                AutomationProperties.Name="Filtrar por domínio" />
            <ui:Button
                Grid.Column="3"
                Margin="0,0,8,0"
                VerticalAlignment="Center"
                Content="{Binding PauseLabel}"
                Command="{Binding TogglePauseCommand}">
                <ui:Button.Style>
                    <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                        <Setter Property="Icon" Value="{ui:SymbolIcon Pause24}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsPaused}" Value="True">
                                <Setter Property="Icon" Value="{ui:SymbolIcon Play24}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ui:Button.Style>
            </ui:Button>
            <ui:Button
                Grid.Column="4"
                VerticalAlignment="Center"
                Icon="{ui:SymbolIcon Delete24}"
                Content="Limpar"
                Command="{Binding ClearCommand}" />
        </Grid>

        <DataGrid
            Grid.Row="1"
            ItemsSource="{Binding View}"
            AutoGenerateColumns="False"
            IsReadOnly="True"
            CanUserAddRows="False"
            CanUserDeleteRows="False"
            CanUserReorderColumns="False"
            CanUserSortColumns="False"
            SelectionMode="Single"
            HeadersVisibility="Column"
            GridLinesVisibility="None"
            EnableRowVirtualization="True"
            VirtualizingPanel.IsVirtualizing="True"
            VirtualizingPanel.VirtualizationMode="Recycling"
            Visibility="{Binding IsEmpty, Converter={StaticResource FalseToVisible}}"
            AutomationProperties.Name="Requisições">
            <!-- On the grid, not the rows: right-click selects the row, and the menu acts on the selection. -->
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem
                        Header="Copiar URL"
                        Command="{Binding Data.CopyUrlCommand, Source={StaticResource Root}}"
                        CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                    <MenuItem
                        Header="Abrir no navegador"
                        Command="{Binding Data.OpenCommand, Source={StaticResource Root}}"
                        CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.Columns>
                <DataGridTextColumn Width="96" Header="Hora" Binding="{Binding Time, Mode=OneTime}">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
                            <Setter Property="FontSize" Value="12" />
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Width="76" Header="Método" Binding="{Binding Method, Mode=OneTime}" />
                <DataGridTextColumn Width="2*" Header="Domínio" Binding="{Binding Host, Mode=OneTime}">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Width="3*" Header="Caminho" Binding="{Binding Path, Mode=OneTime}">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                            <Setter Property="ToolTip" Value="{Binding Path, Mode=OneTime}" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTemplateColumn Width="128" Header="Status">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate DataType="{x:Type vm:RequestItemViewModel}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource StatusText}" Text="{Binding StatusText, Mode=OneTime}" />
                                <Border
                                    Margin="8,0,0,0"
                                    Padding="5,0,5,1"
                                    VerticalAlignment="Center"
                                    CornerRadius="4"
                                    BorderThickness="1"
                                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                    ToolTip="Resposta do próprio Severino, não do seu servidor"
                                    Visibility="{Binding FromProxy, Converter={StaticResource TrueToVisible}}">
                                    <TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="Severino" />
                                </Border>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Width="80" Header="Duração" Binding="{Binding DurationText}">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Right" />
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel
            Grid.Row="1"
            MaxWidth="420"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Visibility="{Binding IsEmpty, Converter={StaticResource TrueToVisible}}">
            <ui:SymbolIcon Symbol="DocumentText24" FontSize="40" HorizontalAlignment="Center" />
            <ui:TextBlock
                Margin="0,12,0,4"
                HorizontalAlignment="Center"
                FontTypography="Subtitle"
                Text="Nenhuma requisição" />
            <ui:TextBlock
                HorizontalAlignment="Center"
                TextAlignment="Center"
                TextWrapping="Wrap"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="{Binding EmptyText}" />
        </StackPanel>
    </Grid>
</UserControl>
