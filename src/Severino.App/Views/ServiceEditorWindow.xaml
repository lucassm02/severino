<ui:FluentWindow
    x:Class="Severino.App.Views.ServiceEditorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:Severino.App.ViewModels"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance Type=vm:ServiceEditorViewModel}"
    Title="{Binding Title}"
    Width="540"
    SizeToContent="Height"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    WindowBackdropType="Mica"
    Icon="/Assets/severino.ico"
    ExtendsContentIntoTitleBar="True">

    <StackPanel>
        <ui:TitleBar Title="{Binding Title}" ShowMaximize="False" ShowMinimize="False" />

        <StackPanel Margin="24,8,24,24">
            <TextBlock
                Margin="0,0,0,12"
                FontSize="12"
                TextWrapping="Wrap"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="{Binding OriginText}"
                Visibility="{Binding OriginText, Converter={StaticResource NullToCollapsed}}" />

            <TextBlock Margin="0,0,0,4" Text="Nomes, um por linha" />
            <ui:TextBox
                x:Name="Names"
                Height="96"
                AcceptsReturn="True"
                VerticalScrollBarVisibility="Auto"
                PlaceholderText="pedidos&#x0a;pedidos.loja"
                AutomationProperties.Name="Nomes"
                Text="{Binding NamesText, UpdateSourceTrigger=PropertyChanged}" />

            <!-- One row per port: what the app calls, then where the service answers. -->
            <Grid Margin="0,12,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="88" />
                    <ColumnDefinition Width="28" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="88" />
                    <ColumnDefinition Width="40" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Porta" ToolTip="A porta que o app chama, como 5432" />
                <TextBlock Grid.Column="2" Text="Destino" ToolTip="Onde o serviço responde: um IP ou um nome do DNS" />
                <TextBlock Grid.Column="4" Text="Na porta" ToolTip="A porta em que o destino responde, como a NodePort 30080" />
            </Grid>
            <ItemsControl ItemsSource="{Binding Ports}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:ServicePortRow}">
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="88" />
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="88" />
                                <ColumnDefinition Width="40" />
                            </Grid.ColumnDefinitions>
                            <ui:TextBox Grid.Column="0" PlaceholderText="80" AutomationProperties.Name="Porta que o app chama" Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Text="→" />
                            <ComboBox
                                Grid.Column="2"
                                IsEditable="True"
                                IsTextSearchEnabled="False"
                                TextSearch.TextPath="Name"
                                ItemsSource="{Binding DataContext.HostSuggestions, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}"
                                ToolTip="Um IP ou um nome do DNS: com o nome, mudar o IP na aba DNS muda o destino"
                                AutomationProperties.Name="Destino">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" />
                                            <TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Detail}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Grid.Column="3" HorizontalAlignment="Center" VerticalAlignment="Center" Text=":" />
                            <ui:TextBox Grid.Column="4" PlaceholderText="30080" AutomationProperties.Name="Porta do destino" Text="{Binding TargetPort, UpdateSourceTrigger=PropertyChanged}" />
                            <ui:Button
                                Grid.Column="5"
                                Margin="4,0,0,0"
                                Appearance="Transparent"
                                Icon="{ui:SymbolIcon Dismiss24}"
                                ToolTip="Tirar esta porta"
                                AutomationProperties.Name="Tirar esta porta"
                                Command="{Binding DataContext.RemovePortCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <ui:Button
                HorizontalAlignment="Left"
                Appearance="Transparent"
                Icon="{ui:SymbolIcon Add24}"
                Content="Outra porta"
                Command="{Binding AddPortCommand}" />
            <TextBlock
                Margin="0,4,0,0"
                FontSize="12"
                TextWrapping="Wrap"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="{Binding AddressText}" />

            <TextBlock Margin="0,12,0,4" Text="Notas" />
            <ui:TextBox AutomationProperties.Name="Notas" Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock
                Margin="0,12,0,0"
                TextWrapping="Wrap"
                Foreground="{DynamicResource SystemFillColorCautionBrush}"
                Text="{Binding Error}"
                Visibility="{Binding Error, Converter={StaticResource NullToCollapsed}}" />

            <StackPanel Margin="0,24,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
                <ui:Button MinWidth="96" Content="Cancelar" IsCancel="True" Command="{Binding CancelCommand}" />
                <ui:Button
                    MinWidth="96"
                    Margin="8,0,0,0"
                    Appearance="Primary"
                    Content="{Binding SaveLabel}"
                    Command="{Binding SaveCommand}" />
            </StackPanel>
        </StackPanel>
    </StackPanel>
</ui:FluentWindow>
