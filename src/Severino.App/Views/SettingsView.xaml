<UserControl
    x:Class="Severino.App.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:res="clr-namespace:Severino.App.Resources"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:Severino.App.ViewModels"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}">
    <ScrollViewer Style="{StaticResource PageScroll}">
        <StackPanel Margin="0,16,0,0">
            <ui:TextBlock Margin="0,0,0,8" FontTypography="BodyStrong" Text="{x:Static res:Strings.Settings_Network}" />
            <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon PlugConnected24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <ui:TextBlock Text="{x:Static res:Strings.Settings_HttpPort}" />
                        <ui:TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontTypography="Caption" Text="{x:Static res:Strings.Settings_HttpPortHint}" />
                        <ui:TextBlock
                            FontTypography="Caption"
                            Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                            Text="{Binding HttpPortError}"
                            Visibility="{Binding HttpPortError, Converter={StaticResource NullToCollapsed}}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <StackPanel Orientation="Horizontal">
                    <ui:TextBox
                        Width="96"
                        Text="{Binding HttpPort, UpdateSourceTrigger=PropertyChanged}"
                        AutomationProperties.Name="{x:Static res:Strings.Settings_HttpPortName}">
                        <ui:TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding ApplyHttpPortCommand}" />
                        </ui:TextBox.InputBindings>
                    </ui:TextBox>
                    <ui:Button Margin="8,0,0,0" Content="{x:Static res:Strings.Common_Apply}" Command="{Binding ApplyHttpPortCommand}" />
                </StackPanel>
            </ui:CardControl>
            <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon PlugConnected24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <ui:TextBlock Text="{x:Static res:Strings.Settings_HttpsPort}" />
                        <ui:TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontTypography="Caption" Text="{x:Static res:Strings.Settings_HttpsPortHint}" />
                        <ui:TextBlock
                            FontTypography="Caption"
                            Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                            Text="{Binding HttpsPortError}"
                            Visibility="{Binding HttpsPortError, Converter={StaticResource NullToCollapsed}}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <StackPanel Orientation="Horizontal">
                    <ui:TextBox
                        Width="96"
                        Text="{Binding HttpsPort, UpdateSourceTrigger=PropertyChanged}"
                        AutomationProperties.Name="{x:Static res:Strings.Settings_HttpsPortName}">
                        <ui:TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding ApplyHttpsPortCommand}" />
                        </ui:TextBox.InputBindings>
                    </ui:TextBox>
                    <ui:Button Margin="8,0,0,0" Content="{x:Static res:Strings.Common_Apply}" Command="{Binding ApplyHttpsPortCommand}" />
                </StackPanel>
            </ui:CardControl>

            <ui:TextBlock Margin="0,16,0,8" FontTypography="BodyStrong" Text="HTTPS" />
            <ui:Card Margin="0,0,0,4" Padding="16">
                <StackPanel>
                    <DockPanel>
                        <ui:SymbolIcon DockPanel.Dock="Left" Margin="0,2,16,0" VerticalAlignment="Top" FontSize="24" Symbol="LockClosed24" />
                        <StackPanel DockPanel.Dock="Right" Margin="16,0,0,0" VerticalAlignment="Top" Orientation="Horizontal">
                            <ui:ProgressRing
                                Width="20"
                                Height="20"
                                Margin="0,0,12,0"
                                IsIndeterminate="True"
                                Visibility="{Binding HttpsBusy, Converter={StaticResource TrueToVisible}}" />
                            <ui:Button
                                Appearance="Primary"
                                Content="{x:Static res:Strings.Settings_HttpsActivate}"
                                Command="{Binding ActivateHttpsCommand}"
                                Visibility="{Binding HttpsActive, Converter={StaticResource FalseToVisible}}" />
                            <ui:Button
                                Content="{x:Static res:Strings.Settings_ExportCa}"
                                Command="{Binding ExportCaCommand}"
                                Visibility="{Binding HttpsActive, Converter={StaticResource TrueToVisible}}" />
                        </StackPanel>
                        <StackPanel>
                            <ui:TextBlock Text="{x:Static res:Strings.Settings_LocalCertificates}" />
                            <ui:TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontTypography="Caption" TextWrapping="Wrap" Text="{Binding HttpsStateText}" />
                            <ui:TextBlock
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                FontTypography="Caption"
                                TextWrapping="Wrap"
                                Text="{Binding CoverageText}"
                                Visibility="{Binding CoverageText, Converter={StaticResource NullToCollapsed}}" />
                            <ui:TextBlock
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                FontTypography="Caption"
                                TextWrapping="Wrap"
                                Text="{Binding ActivateHint}"
                                Visibility="{Binding ActivateHint, Converter={StaticResource NullToCollapsed}}" />
                        </StackPanel>
                    </DockPanel>

                    <ui:InfoBar
                        Margin="0,12,0,0"
                        IsOpen="True"
                        IsClosable="False"
                        Severity="Warning"
                        Message="{Binding UncoveredText}"
                        Visibility="{Binding UncoveredText, Converter={StaticResource NullToCollapsed}}"
                        AutomationProperties.LiveSetting="Polite" />
                    <ui:InfoBar
                        Margin="0,12,0,0"
                        IsOpen="True"
                        IsClosable="False"
                        Severity="Warning"
                        Title="Firefox"
                        Message="{Binding FirefoxHint}"
                        Visibility="{Binding FirefoxHint, Converter={StaticResource NullToCollapsed}}"
                        AutomationProperties.LiveSetting="Polite" />
                    <ui:InfoBar
                        Margin="0,12,0,0"
                        IsOpen="True"
                        IsClosable="False"
                        Severity="Informational"
                        Message="{Binding HttpsMessage}"
                        Visibility="{Binding HttpsMessage, Converter={StaticResource NullToCollapsed}}"
                        AutomationProperties.LiveSetting="Polite" />

                    <StackPanel Margin="40,12,0,0" Visibility="{Binding NodeCommand, Converter={StaticResource NullToCollapsed}}">
                        <ui:TextBlock FontTypography="Caption" TextWrapping="Wrap" Text="{x:Static res:Strings.Settings_NodeHint}" />
                        <DockPanel Margin="0,6,0,0">
                            <ui:Button DockPanel.Dock="Right" Margin="8,0,0,0" Icon="{ui:SymbolIcon Copy24}" Content="{x:Static res:Strings.Common_Copy}" Command="{Binding CopyNodeCommandCommand}" />
                            <ui:TextBox IsReadOnly="True" FontFamily="Cascadia Mono, Consolas" Text="{Binding NodeCommand, Mode=OneWay}" AutomationProperties.Name="{x:Static res:Strings.Settings_NodeCommandName}" />
                        </DockPanel>
                    </StackPanel>

                    <StackPanel Margin="40,12,0,0" Orientation="Horizontal" Visibility="{Binding HttpsActive, Converter={StaticResource TrueToVisible}}">
                        <ui:Button Content="{x:Static res:Strings.Settings_Reissue}" Command="{Binding ReissueHttpsCommand}" ToolTip="{x:Static res:Strings.Settings_ReissueTip}" />
                        <ui:Button Margin="8,0,0,0" Content="{x:Static res:Strings.Settings_RemoveCa}" Command="{Binding RemoveHttpsCommand}" />
                    </StackPanel>
                    <ui:Button
                        Margin="40,12,0,0"
                        HorizontalAlignment="Left"
                        Content="{x:Static res:Strings.Settings_RemoveCa}"
                        Command="{Binding RemoveHttpsCommand}"
                        Visibility="{Binding HttpsBroken, Converter={StaticResource TrueToVisible}}" />

                    <ui:TextBlock
                        Margin="40,12,0,0"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        FontTypography="Caption"
                        TextWrapping="Wrap"
                        Text="{x:Static res:Strings.Settings_HttpsNote}" />
                </StackPanel>
            </ui:Card>

            <ui:TextBlock Margin="0,16,0,8" FontTypography="BodyStrong" Text="{x:Static res:Strings.Settings_Services}" />
            <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon ArrowSync24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <ui:TextBlock Text="{x:Static res:Strings.Settings_WatchServices}" />
                        <ui:TextBlock
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            FontTypography="Caption"
                            TextWrapping="Wrap"
                            Text="{x:Static res:Strings.Settings_WatchServicesHint}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch IsChecked="{Binding WatchServices}" AutomationProperties.Name="{x:Static res:Strings.Settings_WatchServices}" />
            </ui:CardControl>
            <ui:Card Margin="0,0,0,4" Padding="16">
                <StackPanel>
                    <DockPanel>
                        <ui:Button DockPanel.Dock="Right" Margin="16,0,0,0" VerticalAlignment="Top" Content="{x:Static res:Strings.Settings_WslApplyAgain}" Command="{Binding RetryWslCommand}" />
                        <StackPanel>
                            <ui:TextBlock Text="{x:Static res:Strings.Settings_WslTitle}" />
                            <ui:TextBlock
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                FontTypography="Caption"
                                TextWrapping="Wrap"
                                Text="{x:Static res:Strings.Settings_WslHint}" />
                        </StackPanel>
                    </DockPanel>
                    <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding WslDistros}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:WslDistroItem}">
                                <DockPanel Margin="0,6,0,0">
                                    <ui:ToggleSwitch
                                        DockPanel.Dock="Right"
                                        VerticalAlignment="Center"
                                        IsChecked="{Binding IsChosen}"
                                        AutomationProperties.Name="{Binding Name, StringFormat={x:Static res:Strings.Settings_WslDistroName}}" />
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" />
                                        <TextBlock FontSize="12" TextWrapping="Wrap" Text="{Binding StatusText}" Visibility="{Binding StatusText, Converter={StaticResource NullToCollapsed}}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsProblem}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ui:TextBlock
                        Margin="0,8,0,0"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        FontTypography="Caption"
                        Text="{x:Static res:Strings.Settings_NoWsl}"
                        Visibility="{Binding HasNoWsl, Converter={StaticResource TrueToVisible}}" />
                </StackPanel>
            </ui:Card>

            <ui:TextBlock Margin="0,16,0,8" FontTypography="BodyStrong" Text="{x:Static res:Strings.Settings_Terminal}" />
            <ui:Card Margin="0,0,0,4" Padding="16">
                <StackPanel>
                    <DockPanel>
                        <ui:SymbolIcon DockPanel.Dock="Left" Margin="0,2,16,0" VerticalAlignment="Top" FontSize="24" Symbol="WindowConsole20" />
                        <StackPanel>
                            <ui:TextBlock Text="{x:Static res:Strings.Settings_PowerShell}" />
                            <ui:TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontTypography="Caption" TextWrapping="Wrap" Text="{Binding TerminalStatus}" />
                        </StackPanel>
                    </DockPanel>
                    <DockPanel Margin="40,10,0,0">
                        <StackPanel DockPanel.Dock="Right" Margin="8,0,0,0" VerticalAlignment="Top">
                            <ui:Button Icon="{ui:SymbolIcon Copy24}" Content="{x:Static res:Strings.Common_Copy}" Command="{Binding CopyTerminalExamplesCommand}" />
                            <ui:TextBlock Margin="0,4,0,0" HorizontalAlignment="Center" FontTypography="Caption" Text="{Binding TerminalCopied}" />
                        </StackPanel>
                        <ui:TextBox
                            IsReadOnly="True"
                            TextWrapping="NoWrap"
                            HorizontalScrollBarVisibility="Auto"
                            FontFamily="Cascadia Mono, Consolas"
                            FontSize="12"
                            Text="{Binding TerminalExamples, Mode=OneWay}"
                            AutomationProperties.Name="{x:Static res:Strings.Settings_TerminalExamplesName}" />
                    </DockPanel>
                </StackPanel>
            </ui:Card>

            <ui:TextBlock Margin="0,16,0,8" FontTypography="BodyStrong" Text="{x:Static res:Strings.Settings_General}" />
            <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon DarkTheme24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <ui:TextBlock Text="{x:Static res:Strings.Settings_Theme}" />
                        <ui:TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontTypography="Caption" Text="{x:Static res:Strings.Settings_ThemeHint}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ComboBox
                    MinWidth="180"
                    ItemsSource="{Binding Themes}"
                    DisplayMemberPath="Label"
                    SelectedValuePath="Value"
                    SelectedValue="{Binding Theme}" />
            </ui:CardControl>
            <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon LocalLanguage24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <ui:TextBlock Text="{x:Static res:Strings.Settings_Language}" />
                        <ui:TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontTypography="Caption" TextWrapping="Wrap" Text="{x:Static res:Strings.Settings_LanguageHint}" />
                        <ui:TextBlock
                            FontTypography="Caption"
                            Foreground="{DynamicResource SystemFillColorCautionBrush}"
                            TextWrapping="Wrap"
                            Text="{x:Static res:Strings.Settings_LanguageRestart}"
                            Visibility="{Binding LanguageNeedsRestart, Converter={StaticResource TrueToVisible}}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <StackPanel Orientation="Horizontal">
                    <ui:Button
                        Margin="0,0,8,0"
                        Content="{x:Static res:Strings.Settings_RestartNow}"
                        Command="{Binding RestartCommand}"
                        Visibility="{Binding LanguageNeedsRestart, Converter={StaticResource TrueToVisible}}" />
                    <ComboBox
                        MinWidth="180"
                        ItemsSource="{Binding Languages}"
                        DisplayMemberPath="Label"
                        SelectedValuePath="Value"
                        SelectedValue="{Binding Language}"
                        AutomationProperties.Name="{x:Static res:Strings.Settings_Language}" />
                </StackPanel>
            </ui:CardControl>
            <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon Power24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <ui:TextBlock Text="{x:Static res:Strings.Settings_StartWithWindows}" />
                        <ui:TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontTypography="Caption" Text="{x:Static res:Strings.Settings_StartWithWindowsHint}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch IsChecked="{Binding StartWithWindows}" AutomationProperties.Name="{x:Static res:Strings.Settings_StartWithWindows}" />
            </ui:CardControl>
            <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon ArrowMinimize24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <ui:TextBlock Text="{x:Static res:Strings.Settings_StartMinimized}" />
                        <ui:TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontTypography="Caption" Text="{x:Static res:Strings.Settings_StartMinimizedHint}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch IsChecked="{Binding StartMinimized}" AutomationProperties.Name="{x:Static res:Strings.Settings_StartMinimized}" />
            </ui:CardControl>            <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon Alert24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <ui:TextBlock Text="{x:Static res:Strings.Settings_HealthNotifications}" />
                        <ui:TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontTypography="Caption" TextWrapping="Wrap" Text="{x:Static res:Strings.Settings_HealthNotificationsHint}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch IsChecked="{Binding HealthNotifications}" AutomationProperties.Name="{x:Static res:Strings.Settings_HealthNotifications}" />
            </ui:CardControl>


            <ui:TextBlock Margin="0,16,0,8" FontTypography="BodyStrong" Text="{x:Static res:Strings.Settings_Maintenance}" />
            <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon Folder24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <ui:TextBlock Text="{x:Static res:Strings.Settings_ConfigFolder}" />
                        <ui:TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontTypography="Caption" Text="{Binding ConfigDirectory}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:Button Content="{x:Static res:Strings.Settings_OpenFolder}" Command="{Binding OpenConfigFolderCommand}" />
            </ui:CardControl>
            <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon CheckmarkCircle24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <ui:TextBlock Text="{x:Static res:Strings.Settings_ReviewSetup}" />
                        <ui:TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontTypography="Caption" TextWrapping="Wrap" Text="{x:Static res:Strings.Settings_ReviewSetupHint}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:Button Content="{x:Static res:Strings.Common_Open}" Command="{Binding ReviewSetupCommand}" />
            </ui:CardControl>
            <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon ArrowSwap24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <ui:TextBlock Text="{x:Static res:Strings.Settings_Backup}" />
                        <ui:TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontTypography="Caption" TextWrapping="Wrap" Text="{x:Static res:Strings.Settings_BackupHint}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <StackPanel Orientation="Horizontal">
                    <ui:Button Content="{x:Static res:Strings.Common_Export}" Command="{Binding ExportBackupCommand}" />
                    <ui:Button Margin="8,0,0,0" Content="{x:Static res:Strings.Common_Import}" Command="{Binding ImportBackupCommand}" />
                </StackPanel>
            </ui:CardControl>            <!-- Project files (severino.json): opened from here or dropped on the window, applied after a preview. -->
            <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon DocumentFolder24}" Visibility="{Binding Projects, Converter={StaticResource NullToCollapsed}}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <ui:TextBlock Text="{x:Static res:Strings.Project_Settings}" />
                        <ui:TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontTypography="Caption" TextWrapping="Wrap" Text="{x:Static res:Strings.Project_SettingsHint}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:Button Content="{x:Static res:Strings.Project_Open}" Command="{Binding Projects.OpenCommand}" />
            </ui:CardControl>
            <ItemsControl Margin="0,0,0,4" ItemsSource="{Binding Projects.Items}" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:ProjectRow}">
                        <ui:Card Margin="0,0,0,4" Padding="16,10">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <ui:Button
                                        Content="{x:Static res:Strings.Project_Reapply}"
                                        ToolTip="{x:Static res:Strings.Project_ReapplyTip}"
                                        IsEnabled="{Binding CanReapply}"
                                        Command="{Binding DataContext.Projects.ReapplyCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}" />
                                    <ui:Button
                                        Margin="8,0,0,0"
                                        Content="{x:Static res:Strings.Common_Remove}"
                                        ToolTip="{x:Static res:Strings.Project_RemoveTip}"
                                        Command="{Binding DataContext.Projects.RemoveCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}" />
                                </StackPanel>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                                    <TextBlock FontSize="12" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Summary}" ToolTip="{Binding Path}" />
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                        Text="{x:Static res:Strings.Project_FileMissing}"
                                        Visibility="{Binding Missing, Converter={StaticResource TrueToVisible}}" />
                                </StackPanel>
                            </DockPanel>
                        </ui:Card>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon Broom24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <ui:TextBlock Text="{x:Static res:Strings.Settings_CleanUp}" />
                        <ui:TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontTypography="Caption" TextWrapping="Wrap" Text="{x:Static res:Strings.Settings_CleanUpHint}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:Button Content="{x:Static res:Strings.Settings_CleanUpButton}" Command="{Binding CleanAllCommand}" />
            </ui:CardControl>

            <ui:TextBlock Margin="0,16,0,8" FontTypography="BodyStrong" Text="{x:Static res:Strings.Settings_About}" />
            <ui:Card Margin="0,0,0,4" Padding="16" DataContext="{Binding Updates}">
                <DockPanel>
                    <Image
                        DockPanel.Dock="Left"
                        Width="56"
                        Height="56"
                        VerticalAlignment="Top"
                        Source="/Assets/severino-512.png"
                        RenderOptions.BitmapScalingMode="HighQuality"
                        AutomationProperties.Name="Severino" />
                    <StackPanel DockPanel.Dock="Right" Margin="16,0,0,0" VerticalAlignment="Top" Orientation="Horizontal">
                        <ui:ProgressRing
                            Width="20"
                            Height="20"
                            Margin="0,0,12,0"
                            IsIndeterminate="True"
                            Visibility="{Binding IsChecking, Converter={StaticResource TrueToVisible}}" />
                        <ui:Button
                            Appearance="Primary"
                            Content="{Binding InstallText}"
                            Command="{Binding InstallCommand}"
                            Visibility="{Binding HasUpdate, Converter={StaticResource TrueToVisible}}" />
                        <ui:Button
                            Content="{x:Static res:Strings.Updates_CheckNow}"
                            Command="{Binding CheckNowCommand}"
                            Visibility="{Binding HasUpdate, Converter={StaticResource FalseToVisible}}" />
                    </StackPanel>
                    <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                        <ui:TextBlock FontTypography="BodyStrong" Text="{Binding CurrentVersion, StringFormat={x:Static res:Strings.Settings_AppVersion}}" />
                        <ui:TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Text="{x:Static res:Strings.Settings_Tagline}" />
                        <ui:TextBlock
                            Margin="0,8,0,0"
                            TextWrapping="Wrap"
                            Text="{Binding StatusText}"
                            Visibility="{Binding StatusText, Converter={StaticResource NullToCollapsed}}" />
                        <ui:TextBlock
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            FontTypography="Caption"
                            Text="{Binding LastCheckText}"
                            Visibility="{Binding LastCheckText, Converter={StaticResource NullToCollapsed}}" />
                    </StackPanel>
                </DockPanel>
            </ui:Card>
            <ui:CardControl Margin="0,0,0,16" Icon="{ui:SymbolIcon ArrowDownload24}" DataContext="{Binding Updates}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <ui:TextBlock Text="{x:Static res:Strings.Updates_AutoCheck}" />
                        <ui:TextBlock
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            FontTypography="Caption"
                            TextWrapping="Wrap"
                            Text="{x:Static res:Strings.Updates_AutoCheckHint}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch IsChecked="{Binding AutoCheck}" AutomationProperties.Name="{x:Static res:Strings.Updates_AutoCheck}" />
            </ui:CardControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
