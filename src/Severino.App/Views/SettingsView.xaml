<UserControl
    x:Class="Severino.App.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:Severino.App.ViewModels"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,16,0,0">
            <ui:TextBlock Margin="0,0,0,8" FontTypography="BodyStrong" Text="Rede" />
            <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon PlugConnected24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <ui:TextBlock Text="Porta HTTP do proxy" />
                        <ui:TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontTypography="Caption" Text="Fora da 80, as URLs passam a levar a porta (ex.: :8080)" />
                        <ui:TextBlock
                            FontTypography="Caption"
                            Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                            Text="{Binding HttpPortError}"
                            Visibility="{Binding HttpPortError, Converter={StaticResource NullToCollapsed}}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <StackPanel Orientation="Horizontal">
                    <ui:TextBox
                        Width="96"
                        Text="{Binding HttpPort, UpdateSourceTrigger=PropertyChanged}"
                        AutomationProperties.Name="Porta HTTP">
                        <ui:TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding ApplyHttpPortCommand}" />
                        </ui:TextBox.InputBindings>
                    </ui:TextBox>
                    <ui:Button Margin="8,0,0,0" Content="Aplicar" Command="{Binding ApplyHttpPortCommand}" />
                </StackPanel>
            </ui:CardControl>

            <ui:TextBlock Margin="0,16,0,8" FontTypography="BodyStrong" Text="HTTPS" />
            <ui:Card Margin="0,0,0,4" Padding="16">
                <StackPanel>
                    <DockPanel>
                        <ui:SymbolIcon DockPanel.Dock="Left" Margin="0,2,16,0" VerticalAlignment="Top" FontSize="24" Symbol="LockClosed24" />
                        <StackPanel DockPanel.Dock="Right" Margin="16,0,0,0" VerticalAlignment="Top" Orientation="Horizontal">
                            <ui:ProgressRing
                                Width="20"
                                Height="20"
                                Margin="0,0,12,0"
                                IsIndeterminate="True"
                                Visibility="{Binding HttpsBusy, Converter={StaticResource TrueToVisible}}" />
                            <ui:Button
                                Appearance="Primary"
                                Content="Ativar HTTPS"
                                Command="{Binding ActivateHttpsCommand}"
                                Visibility="{Binding HttpsActive, Converter={StaticResource FalseToVisible}}" />
                            <ui:Button
                                Content="Exportar CA (PEM)"
                                Command="{Binding ExportCaCommand}"
                                Visibility="{Binding HttpsActive, Converter={StaticResource TrueToVisible}}" />
                        </StackPanel>
                        <StackPanel>
                            <ui:TextBlock Text="Certificados locais" />
                            <ui:TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontTypography="Caption" TextWrapping="Wrap" Text="{Binding HttpsStateText}" />
                            <ui:TextBlock
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                FontTypography="Caption"
                                TextWrapping="Wrap"
                                Text="{Binding CoverageText}"
                                Visibility="{Binding CoverageText, Converter={StaticResource NullToCollapsed}}" />
                            <ui:TextBlock
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                FontTypography="Caption"
                                TextWrapping="Wrap"
                                Text="{Binding ActivateHint}"
                                Visibility="{Binding ActivateHint, Converter={StaticResource NullToCollapsed}}" />
                        </StackPanel>
                    </DockPanel>

                    <ui:InfoBar
                        Margin="0,12,0,0"
                        IsOpen="True"
                        IsClosable="False"
                        Severity="Warning"
                        Message="{Binding UncoveredText}"
                        Visibility="{Binding UncoveredText, Converter={StaticResource NullToCollapsed}}"
                        AutomationProperties.LiveSetting="Polite" />
                    <ui:InfoBar
                        Margin="0,12,0,0"
                        IsOpen="True"
                        IsClosable="False"
                        Severity="Warning"
                        Title="Firefox"
                        Message="{Binding FirefoxHint}"
                        Visibility="{Binding FirefoxHint, Converter={StaticResource NullToCollapsed}}"
                        AutomationProperties.LiveSetting="Polite" />
                    <ui:InfoBar
                        Margin="0,12,0,0"
                        IsOpen="True"
                        IsClosable="False"
                        Severity="Informational"
                        Message="{Binding HttpsMessage}"
                        Visibility="{Binding HttpsMessage, Converter={StaticResource NullToCollapsed}}"
                        AutomationProperties.LiveSetting="Polite" />

                    <StackPanel Margin="40,12,0,0" Visibility="{Binding NodeCommand, Converter={StaticResource NullToCollapsed}}">
                        <ui:TextBlock FontTypography="Caption" TextWrapping="Wrap" Text="Para o Node.js confiar na CA, rode uma vez e abra um terminal novo:" />
                        <DockPanel Margin="0,6,0,0">
                            <ui:Button DockPanel.Dock="Right" Margin="8,0,0,0" Icon="{ui:SymbolIcon Copy24}" Content="Copiar" Command="{Binding CopyNodeCommandCommand}" />
                            <ui:TextBox IsReadOnly="True" FontFamily="Cascadia Mono, Consolas" Text="{Binding NodeCommand, Mode=OneWay}" AutomationProperties.Name="Comando do Node.js" />
                        </DockPanel>
                    </StackPanel>

                    <StackPanel Margin="40,12,0,0" Orientation="Horizontal" Visibility="{Binding HttpsActive, Converter={StaticResource TrueToVisible}}">
                        <ui:Button Content="Reemitir" Command="{Binding ReissueHttpsCommand}" ToolTip="Cria uma CA nova para os domínios das rotas com HTTPS de hoje" />
                        <ui:Button Margin="8,0,0,0" Content="Remover CA" Command="{Binding RemoveHttpsCommand}" />
                    </StackPanel>
                    <ui:Button
                        Margin="40,12,0,0"
                        HorizontalAlignment="Left"
                        Content="Remover CA"
                        Command="{Binding RemoveHttpsCommand}"
                        Visibility="{Binding HttpsBroken, Converter={StaticResource TrueToVisible}}" />

                    <ui:TextBlock
                        Margin="40,12,0,0"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        FontTypography="Caption"
                        TextWrapping="Wrap"
                        Text="Ao ativar, o Windows pede para confirmar a instalação da CA. Ela só assina os domínios das rotas." />
                </StackPanel>
            </ui:Card>
            <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon PlugConnected24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <ui:TextBlock Text="Porta HTTPS do proxy" />
                        <ui:TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontTypography="Caption" Text="Fora da 443, as URLs https:// passam a levar a porta" />
                        <ui:TextBlock
                            FontTypography="Caption"
                            Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                            Text="{Binding HttpsPortError}"
                            Visibility="{Binding HttpsPortError, Converter={StaticResource NullToCollapsed}}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <StackPanel Orientation="Horizontal">
                    <ui:TextBox
                        Width="96"
                        Text="{Binding HttpsPort, UpdateSourceTrigger=PropertyChanged}"
                        AutomationProperties.Name="Porta HTTPS">
                        <ui:TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding ApplyHttpsPortCommand}" />
                        </ui:TextBox.InputBindings>
                    </ui:TextBox>
                    <ui:Button Margin="8,0,0,0" Content="Aplicar" Command="{Binding ApplyHttpsPortCommand}" />
                </StackPanel>
            </ui:CardControl>

            <ui:TextBlock Margin="0,16,0,8" FontTypography="BodyStrong" Text="WSL" />
            <ui:Card Margin="0,0,0,4" Padding="16">
                <StackPanel>
                    <DockPanel>
                        <ui:Button DockPanel.Dock="Right" Margin="16,0,0,0" VerticalAlignment="Top" Content="Aplicar de novo" Command="{Binding RetryWslCommand}" />
                        <StackPanel>
                            <ui:TextBlock Text="Apps no WSL chamam os serviços pelo nome" />
                            <ui:TextBlock
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                FontTypography="Caption"
                                TextWrapping="Wrap"
                                Text="Nas distros ligadas, o Severino grava os nomes no /etc/hosts e regras de iptables que levam cada porta ao destino, como root na distro, sem pedir administrador. Distros paradas recebem tudo quando iniciam. Containers do Docker no Windows ficam de fora: a distro não vê o loopback do Windows." />
                        </StackPanel>
                    </DockPanel>
                    <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding WslDistros}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:WslDistroItem}">
                                <DockPanel Margin="0,6,0,0">
                                    <ui:ToggleSwitch
                                        DockPanel.Dock="Right"
                                        VerticalAlignment="Center"
                                        IsChecked="{Binding IsChosen}"
                                        AutomationProperties.Name="{Binding Name, StringFormat='Serviços pelo nome em {0}'}" />
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" />
                                        <TextBlock FontSize="12" TextWrapping="Wrap" Text="{Binding StatusText}" Visibility="{Binding StatusText, Converter={StaticResource NullToCollapsed}}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsProblem}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ui:TextBlock
                        Margin="0,8,0,0"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        FontTypography="Caption"
                        Text="Nenhuma distro do WSL instalada."
                        Visibility="{Binding HasNoWsl, Converter={StaticResource TrueToVisible}}" />
                </StackPanel>
            </ui:Card>

            <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon ArrowSync24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <ui:TextBlock Text="Acompanhar serviços importados" />
                        <ui:TextBlock
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            FontTypography="Caption"
                            TextWrapping="Wrap"
                            Text="Com o app aberto, faz o Atualizar sozinho: quando um container do Docker sobe ou cai, e no Kubernetes a cada 30 s." />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch IsChecked="{Binding WatchServices}" AutomationProperties.Name="Acompanhar serviços importados" />
            </ui:CardControl>

            <ui:TextBlock Margin="0,16,0,8" FontTypography="BodyStrong" Text="Aparência" />
            <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon DarkTheme24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <ui:TextBlock Text="Tema" />
                        <ui:TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontTypography="Caption" Text="Claro, escuro ou igual ao Windows" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ComboBox
                    MinWidth="180"
                    ItemsSource="{Binding Themes}"
                    DisplayMemberPath="Label"
                    SelectedValuePath="Value"
                    SelectedValue="{Binding Theme}" />
            </ui:CardControl>

            <ui:TextBlock Margin="0,16,0,8" FontTypography="BodyStrong" Text="Inicialização" />
            <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon Power24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <ui:TextBlock Text="Iniciar com o Windows" />
                        <ui:TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontTypography="Caption" Text="Abre na bandeja quando você entra no Windows" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch IsChecked="{Binding StartWithWindows}" AutomationProperties.Name="Iniciar com o Windows" />
            </ui:CardControl>
            <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon ArrowMinimize24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <ui:TextBlock Text="Iniciar minimizado" />
                        <ui:TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontTypography="Caption" Text="Ao abrir pelo atalho, vai direto para a bandeja, sem mostrar a janela" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch IsChecked="{Binding StartMinimized}" AutomationProperties.Name="Iniciar minimizado" />
            </ui:CardControl>

            <ui:TextBlock Margin="0,16,0,8" FontTypography="BodyStrong" Text="Manutenção" />
            <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon Folder24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <ui:TextBlock Text="Pasta de configuração" />
                        <ui:TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontTypography="Caption" Text="{Binding ConfigDirectory}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:Button Content="Abrir pasta" Command="{Binding OpenConfigFolderCommand}" />
            </ui:CardControl>
            <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon CheckmarkCircle24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <ui:TextBlock Text="Rever checagem" />
                        <ui:TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontTypography="Caption" TextWrapping="Wrap" Text="Abre de novo o assistente do primeiro uso: serviço auxiliar, porta e proxy do sistema" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:Button Content="Abrir" Command="{Binding ReviewSetupCommand}" />
            </ui:CardControl>
            <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon ArrowSwap24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <ui:TextBlock Text="Rotas" />
                        <ui:TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontTypography="Caption" TextWrapping="Wrap" Text="Leve suas rotas para outra máquina num arquivo JSON. Importar só acrescenta: rotas que já existem ficam como estão." />
                    </StackPanel>
                </ui:CardControl.Header>
                <StackPanel Orientation="Horizontal">
                    <ui:Button Content="Exportar" Command="{Binding ExportRoutesCommand}" />
                    <ui:Button Margin="8,0,0,0" Content="Importar" Command="{Binding ImportRoutesCommand}" />
                </StackPanel>
            </ui:CardControl>
            <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon Broom24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <ui:TextBlock Text="Limpar tudo" />
                        <ui:TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontTypography="Caption" TextWrapping="Wrap" Text="Tira do Windows o bloco do hosts, a CA local, a inicialização automática e as exceções de proxy, tira os nomes das distros do WSL, e fecha o app" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:Button Content="Limpar tudo…" Command="{Binding CleanAllCommand}" />
            </ui:CardControl>

            <ui:TextBlock Margin="0,16,0,8" FontTypography="BodyStrong" Text="Sobre" />
            <ui:Card Margin="0,0,0,16" Padding="16">
                <StackPanel Orientation="Horizontal">
                    <Image
                        Width="56"
                        Height="56"
                        Source="/Assets/severino-512.png"
                        RenderOptions.BitmapScalingMode="HighQuality"
                        AutomationProperties.Name="Severino" />
                    <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                        <ui:TextBlock FontTypography="BodyStrong" Text="{Binding Version, StringFormat='Severino {0}'}" />
                        <ui:TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Text="O porteiro dos seus domínios de desenvolvimento." />
                    </StackPanel>
                </StackPanel>
            </ui:Card>
        </StackPanel>
    </ScrollViewer>
</UserControl>
