<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- The page lists. WPF-UI draws the vertical scroll bar over the content; while it shows,
         the content moves aside so the bar never covers a card's buttons. -->
    <Style x:Key="PageScroll" TargetType="ScrollViewer" BasedOn="{StaticResource {x:Type ScrollViewer}}">
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        <Style.Triggers>
            <Trigger Property="ComputedVerticalScrollBarVisibility" Value="Visible">
                <Setter Property="Padding" Value="0,0,16,0" />
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
