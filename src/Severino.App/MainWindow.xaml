<ui:FluentWindow
    x:Class="Severino.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:res="clr-namespace:Severino.App.Resources"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:views="clr-namespace:Severino.App.Views"
    xmlns:vm="clr-namespace:Severino.App.ViewModels"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance Type=vm:MainWindowViewModel}"
    Title="Severino"
    Width="880"
    Height="560"
    MinWidth="640"
    MinHeight="420"
    WindowStartupLocation="CenterScreen"
    WindowBackdropType="Mica"
    Icon="/Assets/severino.ico"
    ExtendsContentIntoTitleBar="True"
    AllowDrop="True"
    DragOver="OnDragOver"
    Drop="OnDrop">
    <ui:FluentWindow.Resources>
        <Style x:Key="StatusLink" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
            <Setter Property="Appearance" Value="Transparent" />
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
        </Style>
        <!-- A choice, not a problem: the accent colour, with a chevron saying it opens a list. -->
        <Style x:Key="StatusChoice" TargetType="ui:Button" BasedOn="{StaticResource StatusLink}">
            <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
            <Setter Property="Icon" Value="{ui:SymbolIcon ChevronDown16}" />
            <Setter Property="FlowDirection" Value="RightToLeft" />
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Severino" ShowMaximize="True">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="/Assets/severino-512.png" RenderOptions.BitmapScalingMode="HighQuality" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <!-- A newer release: shown until installed, skipped or closed for this run. -->
        <!-- Not a ui:InfoBar: its template leaves out the content, and the notice needs buttons. -->
        <Border
            Grid.Row="1"
            Margin="16,0,16,8"
            Padding="16,12,8,12"
            CornerRadius="8"
            BorderThickness="1"
            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            DataContext="{Binding Updates}"
            Visibility="{Binding IsBannerOpen, Converter={StaticResource TrueToVisible}}"
            AutomationProperties.Name="{Binding BannerTitle}"
            AutomationProperties.LiveSetting="Polite">
            <DockPanel>
                <ui:Button
                    DockPanel.Dock="Right"
                    VerticalAlignment="Top"
                    Appearance="Transparent"
                    Icon="{ui:SymbolIcon Dismiss20}"
                    Command="{Binding DismissCommand}"
                    ToolTip="{x:Static res:Strings.Main_HideNoticeTip}"
                    AutomationProperties.Name="{x:Static res:Strings.Main_CloseNotice}" />
                <ui:SymbolIcon
                    DockPanel.Dock="Left"
                    Margin="0,2,14,0"
                    VerticalAlignment="Top"
                    FontSize="24"
                    Symbol="ArrowCircleUp24"
                    Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                <StackPanel>
                    <ui:TextBlock FontTypography="BodyStrong" Text="{Binding BannerTitle}" />
                    <ui:TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Text="{Binding BannerMessage}" />
                    <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                        <ui:Button Appearance="Primary" Content="{Binding InstallText}" Command="{Binding InstallCommand}" />
                        <ui:Button Margin="8,0,0,0" Content="{x:Static res:Strings.Updates_WhatsNew}" Command="{Binding OpenReleasePageCommand}" />
                        <ui:Button Margin="8,0,0,0" Appearance="Transparent" Content="{x:Static res:Strings.Updates_Skip}" Command="{Binding SkipCommand}" />
                        <ProgressBar
                            Width="160"
                            Margin="12,0,0,0"
                            VerticalAlignment="Center"
                            Maximum="100"
                            Value="{Binding DownloadProgress}"
                            Visibility="{Binding IsDownloading, Converter={StaticResource TrueToVisible}}"
                            AutomationProperties.Name="{x:Static res:Strings.Updates_DownloadProgress}" />
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <TabControl Grid.Row="2" Margin="16,0,16,8" SelectedIndex="{Binding SelectedTab}">
            <TabItem Header="{x:Static res:Strings.Tab_Routes}">
                <views:RoutesView DataContext="{Binding Routes}" />
            </TabItem>
            <TabItem Header="{x:Static res:Strings.Tab_Services}">
                <views:ServicesView DataContext="{Binding Services}" />
            </TabItem>
            <TabItem Header="DNS">
                <views:DnsView DataContext="{Binding Dns}" />
            </TabItem>
            <TabItem Header="{x:Static res:Strings.Tab_Requests}">
                <views:RequestsView DataContext="{Binding Requests}" />
            </TabItem>
            <TabItem Header="{x:Static res:Strings.Tab_Settings}">
                <views:SettingsView DataContext="{Binding Settings}" />
            </TabItem>
        </TabControl>

        <!-- The active environment, while some item has one; a click picks another. -->
        <ui:Button
            Grid.Row="3"
            Margin="16,0,16,8"
            HorizontalAlignment="Right"
            Style="{StaticResource StatusChoice}"
            DataContext="{Binding Environments}"
            Content="{Binding Label}"
            ToolTip="{x:Static res:Strings.Env_StatusTip}"
            Visibility="{Binding HasAny, Converter={StaticResource TrueToVisible}, FallbackValue=Collapsed}"
            Click="OnMoreClick">
            <ui:Button.ContextMenu>
                <ContextMenu FlowDirection="LeftToRight" ItemsSource="{Binding Choices}">
                    <ContextMenu.ItemContainerStyle>
                        <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                            <Setter Property="Header" Value="{Binding Label}" />
                            <Setter Property="IsChecked" Value="{Binding IsActive, Mode=OneWay}" />
                            <Setter Property="Command" Value="{Binding DataContext.SelectCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            <Setter Property="CommandParameter" Value="{Binding Name}" />
                        </Style>
                    </ContextMenu.ItemContainerStyle>
                </ContextMenu>
            </ui:Button.ContextMenu>
        </ui:Button>        <StackPanel
            Grid.Row="3"
            Margin="16,0,16,8"
            DataContext="{Binding Status}"
            Orientation="Horizontal">
            <ui:TextBlock
                VerticalAlignment="Center"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="{Binding ProxyText}"
                Visibility="{Binding ProxyHasProblem, Converter={StaticResource FalseToVisible}}" />
            <ui:Button
                Style="{StaticResource StatusLink}"
                Content="{Binding ProxyText}"
                Command="{Binding FixProxyCommand}"
                Visibility="{Binding ProxyHasProblem, Converter={StaticResource TrueToVisible}}" />
            <ui:TextBlock Margin="8,0" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="·" />
            <ui:TextBlock
                VerticalAlignment="Center"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="{Binding HttpsText}"
                Visibility="{Binding HttpsHasProblem, Converter={StaticResource FalseToVisible}}" />
            <ui:Button
                Style="{StaticResource StatusLink}"
                Content="{Binding HttpsText}"
                Command="{Binding FixHttpsCommand}"
                Visibility="{Binding HttpsHasProblem, Converter={StaticResource TrueToVisible}}" />
            <ui:TextBlock Margin="8,0" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="·" />
            <ui:TextBlock
                VerticalAlignment="Center"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="{Binding HostsText}"
                Visibility="{Binding HostsHasProblem, Converter={StaticResource FalseToVisible}}" />
            <ui:Button
                Style="{StaticResource StatusLink}"
                Content="{Binding HostsText}"
                Command="{Binding FixHostsCommand}"
                Visibility="{Binding HostsHasProblem, Converter={StaticResource TrueToVisible}}" />
            <!-- Only when a service route port did not open. -->
            <StackPanel Orientation="Horizontal" Visibility="{Binding ServicesText, Converter={StaticResource NullToCollapsed}}">
                <ui:TextBlock Margin="8,0" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="·" />
                <ui:Button
                    Style="{StaticResource StatusLink}"
                    Content="{Binding ServicesText}"
                    Command="{Binding FixServicesCommand}" />
            </StackPanel>
            <!-- Only when the system proxy is in the way: nothing to say otherwise. -->
            <StackPanel Orientation="Horizontal" Visibility="{Binding SystemProxyText, Converter={StaticResource NullToCollapsed}}">
                <ui:TextBlock Margin="8,0" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="·" />
                <ui:Button
                    Style="{StaticResource StatusLink}"
                    Content="{Binding SystemProxyText}"
                    Command="{Binding FixSystemProxyCommand}" />
            </StackPanel>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
