<ui:FluentWindow
    x:Class="Severino.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:views="clr-namespace:Severino.App.Views"
    xmlns:vm="clr-namespace:Severino.App.ViewModels"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance Type=vm:MainWindowViewModel}"
    Title="Severino"
    Width="880"
    Height="560"
    MinWidth="640"
    MinHeight="420"
    WindowStartupLocation="CenterScreen"
    WindowBackdropType="Mica"
    Icon="/Assets/severino.ico"
    ExtendsContentIntoTitleBar="True">
    <ui:FluentWindow.Resources>
        <Style x:Key="StatusLink" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
            <Setter Property="Appearance" Value="Transparent" />
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Severino" ShowMaximize="True">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="/Assets/severino-512.png" RenderOptions.BitmapScalingMode="HighQuality" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <TabControl Grid.Row="1" Margin="16,0,16,8" SelectedIndex="{Binding SelectedTab}">
            <TabItem Header="Rotas">
                <views:RoutesView DataContext="{Binding Routes}" />
            </TabItem>
            <TabItem Header="Requisições">
                <views:RequestsView />
            </TabItem>
            <TabItem Header="Configurações">
                <views:SettingsView DataContext="{Binding Settings}" />
            </TabItem>
        </TabControl>

        <StackPanel
            Grid.Row="2"
            Margin="16,0,16,8"
            DataContext="{Binding Status}"
            Orientation="Horizontal">
            <ui:TextBlock
                VerticalAlignment="Center"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="{Binding ProxyText}"
                Visibility="{Binding ProxyHasProblem, Converter={StaticResource FalseToVisible}}" />
            <ui:Button
                Style="{StaticResource StatusLink}"
                Content="{Binding ProxyText}"
                Command="{Binding FixProxyCommand}"
                Visibility="{Binding ProxyHasProblem, Converter={StaticResource TrueToVisible}}" />
            <ui:TextBlock Margin="8,0" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="·" />
            <ui:TextBlock
                VerticalAlignment="Center"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="{Binding HttpsText}"
                Visibility="{Binding HttpsHasProblem, Converter={StaticResource FalseToVisible}}" />
            <ui:Button
                Style="{StaticResource StatusLink}"
                Content="{Binding HttpsText}"
                Command="{Binding FixHttpsCommand}"
                Visibility="{Binding HttpsHasProblem, Converter={StaticResource TrueToVisible}}" />
            <ui:TextBlock Margin="8,0" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="·" />
            <ui:TextBlock
                VerticalAlignment="Center"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="{Binding HostsText}"
                Visibility="{Binding HostsHasProblem, Converter={StaticResource FalseToVisible}}" />
            <ui:Button
                Style="{StaticResource StatusLink}"
                Content="{Binding HostsText}"
                Command="{Binding FixHostsCommand}"
                Visibility="{Binding HostsHasProblem, Converter={StaticResource TrueToVisible}}" />
        </StackPanel>
    </Grid>
</ui:FluentWindow>
