<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tb="clr-namespace:H.NotifyIcon;assembly=H.NotifyIcon.Wpf">

    <!-- The image is set by TrayService from Assets/severino.ico, at the size the tray uses. -->
    <tb:TaskbarIcon
        x:Key="TrayIcon"
        ToolTipText="Severino"
        NoLeftClickDelay="True"
        LeftClickCommand="{Binding ShowWindowCommand}"
        MenuActivation="RightClick">
        <tb:TaskbarIcon.ContextMenu>
            <ContextMenu>
                <MenuItem Header="Abrir Severino" FontWeight="SemiBold" Command="{Binding ShowWindowCommand}" />
                <Separator />
                <MenuItem Header="Sair" Command="{Binding ExitCommand}" />
            </ContextMenu>
        </tb:TaskbarIcon.ContextMenu>
    </tb:TaskbarIcon>
</ResourceDictionary>
