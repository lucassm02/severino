<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Windows only: DPAPI and the Trusted Root store hold the local CA. -->
    <TargetFramework>net10.0-windows</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.ProtectedData" />
    <PackageReference Include="Yarp.ReverseProxy" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Severino.Core\Severino.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Generated by scripts/build-icons.cs; inlined into the error pages. -->
    <EmbeddedResource Include="Assets\severino-192.png" LogicalName="Severino.Proxy.severino-192.png" />
  </ItemGroup>

</Project>
