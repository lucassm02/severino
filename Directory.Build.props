<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Company>Severino</Company>
    <Product>Severino</Product>
    <!-- 0.(phase).x until 1.0; scripts/build-installer.ps1 names the setup after it. -->
    <Version>0.3.0</Version>
  </PropertyGroup>
</Project>
